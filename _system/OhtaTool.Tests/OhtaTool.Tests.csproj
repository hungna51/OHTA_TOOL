<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Bo Unit Test doc lap cho Core/ cua OHTA TOOL (chay khong can mo ZWCAD hay AutoCAD).
    Bien dich thang cac file Core/*.cs tren .NET 10.0.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OhtaTool.Plugin\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

