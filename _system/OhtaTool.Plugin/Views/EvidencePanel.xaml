<UserControl x:Class="OhtaTool.Plugin.Views.EvidencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bằng chứng (người xác nhận + ghi chú + 1–3 ảnh) dùng chung: T thực (Bổ sung vật liệu) và thông số dao (Góc bẻ thử) -->
    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtTitle" Grid.ColumnSpan="2" Text="BẰNG CHỨNG (bắt buộc)" FontSize="11.5" FontWeight="Bold"
                       Foreground="#C2410C" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Text="Người xác nhận" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtNguoi" Grid.Row="1" Grid.Column="1" Height="25" FontSize="12"
                     VerticalContentAlignment="Center" Margin="0,0,0,6"
                     ToolTip="Tên người đã đo / kiểm tra thực tế (tổ trưởng, QC...)"/>

            <TextBlock Grid.Row="2" Text="Ghi chú" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox x:Name="TxtGhiChu" Grid.Row="2" Grid.Column="1" Height="46" FontSize="12" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                     ToolTip="Đo bằng gì, ở đâu, ngày nào, tấm / đơn hàng nào..."/>

            <TextBlock Grid.Row="3" Text="Ảnh (1–3)" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <StackPanel Grid.Row="3" Grid.Column="1">
                <WrapPanel>
                    <Button Content="📁  Chọn ảnh..." Padding="10,4" Margin="0,0,6,4" Click="OnPickImagesClick" Cursor="Hand"/>
                    <Button Content="📋  Dán ảnh (Ctrl+V)" Padding="10,4" Margin="0,0,0,4" Click="OnPasteImageClick" Cursor="Hand"/>
                </WrapPanel>
                <WrapPanel x:Name="PanelImages" Margin="0,4,0,0"/>
                <TextBlock FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Chụp thước đo / phiếu đo. Ảnh tự thu nhỏ trước khi gửi. Không chụp thông tin nhạy cảm của khách hàng."/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
