<Window x:Class="OhtaTool.Plugin.Views.FnameTamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bổ Sung Thông Số Tấm — Fname"
        Width="520"
        Height="640"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DialogSecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0277BD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0277BD" Padding="16,10">
            <StackPanel>
                <TextBlock Text="Bổ Sung Thông Số Tấm (T thực)"
                           Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold"/>
                <TextBlock Text="Chỉ cho tấm chưa có T thực. Bắt buộc người xác nhận, ghi chú và ít nhất 1 ảnh. Máy này dùng được ngay; admin duyệt xong mọi máy nhận được"
                           Foreground="#E1F5FE" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại vật liệu" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbLoai" Grid.Row="0" Grid.Column="1" IsEditable="True" Height="25" FontSize="12"
                          VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldHint}"
                           Text="SS, SUS, AL, SS SIMA, SUS SIMA... (SIMA ghi 1 tên chung, dùng cho cả Trong lẫn Ngoài)."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ dày T=" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtT" Grid.Row="2" Grid.Column="1" Height="25" FontSize="12" FontFamily="Consolas"
                         VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="T thực" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtTHienThi" Grid.Row="3" Grid.Column="1" Height="25" FontSize="12" FontFamily="Consolas"
                         VerticalContentAlignment="Center" Margin="0,0,0,8"
                         ToolTip="T thực để người dùng xem / tính toán (số hiện trên nhãn T thực của bảng Fname)"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Người xác nhận" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNguoi" Grid.Row="4" Grid.Column="1" Height="25" FontSize="12"
                         VerticalContentAlignment="Center" Margin="0,0,0,8"
                         ToolTip="Tên người đã đo / kiểm tra thực tế (tổ trưởng, QC...)"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Ghi chú" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox x:Name="TxtGhiChu" Grid.Row="5" Grid.Column="1" Height="54" FontSize="12" TextWrapping="Wrap"
                         AcceptsReturn="False" VerticalScrollBarVisibility="Auto" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldHint}"
                           Text="Đo bằng gì, ở đâu, ngày nào, tấm / đơn hàng nào..."/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Ảnh bằng chứng" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="7" Grid.Column="1">
                    <WrapPanel>
                        <Button Style="{StaticResource DialogSecondaryBtnStyle}" Content="📁  Chọn ảnh..." Padding="10,4"
                                Margin="0,0,6,4" Click="OnPickImagesClick"/>
                        <Button Style="{StaticResource DialogSecondaryBtnStyle}" Content="📋  Dán ảnh (Ctrl+V)" Padding="10,4"
                                Margin="0,0,0,4" Click="OnPasteImageClick"/>
                    </WrapPanel>
                    <WrapPanel x:Name="PanelImages" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtImageHint" Style="{StaticResource FieldHint}"
                               Text="Tối đa 3 ảnh (chụp thước đo / phiếu đo...). Ảnh lớn tự thu nhỏ trước khi gửi. Không chụp thông tin nhạy cảm của khách hàng."/>
                </StackPanel>

                <TextBlock x:Name="TxtKeyState" Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldHint}"/>

                <Border Grid.Row="9" Grid.ColumnSpan="2" x:Name="StatusBorder" Visibility="Collapsed"
                        CornerRadius="5" Padding="10,7" Margin="0,4,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                    <TextBlock x:Name="TxtStatus" FontSize="11.5" TextWrapping="Wrap" Foreground="#1E3A8A"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogSecondaryBtnStyle}" Content="Đóng" IsCancel="True"
                        Margin="0,0,8,0" Click="OnCloseClick"/>
                <Button x:Name="BtnSubmit" Style="{StaticResource DialogPrimaryBtnStyle}" Content="⬆  Gửi yêu cầu duyệt"
                        IsDefault="True" Click="OnSubmitClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
