<UserControl x:Class="OhtaTool.Plugin.Views.PrintTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="WhiteIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F5E9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header theo màu tab -->
            <Border Background="{Binding AccentBrush}" Padding="12,10">
                <DockPanel LastChildFill="True">
                    <!-- Nền trắng, bánh răng tô màu tab (logo làm mặt nạ) như Fname/Guro -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource WhiteIconBtnStyle}" Command="{Binding SettingsCommand}" IsEnabled="{Binding IsIdle}"
                            Width="30" Height="30" Padding="4" Margin="6,0,0,0" VerticalAlignment="Top"
                            ToolTip="Cài đặt in: mặc định, layer khung, cấu hình in">
                        <Rectangle Width="18" Height="18" Fill="{Binding AccentBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding SettingsLogo}" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WhiteIconBtnStyle}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                            Width="30" Height="30" Padding="0" Margin="6,0,0,0" VerticalAlignment="Top"
                            ToolTip="Đọc lại bản vẽ và danh sách máy in">
                        <TextBlock Text="⟳" FontSize="15" Foreground="{Binding AccentBrush}"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}" Foreground="#E8F5E9" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="12,4,12,12">
                <!-- Khoá khi đang in (palette vẫn nhận cú bấm giữa hai trang) -->
                <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Cấu hình in"/>
                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}"/>
                <Border Visibility="{Binding WarningVisibility}" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                        CornerRadius="4" Padding="7,5" Margin="0,5,0,0">
                    <TextBlock Text="{Binding WarningText}" Foreground="#E65100" FontSize="11.5" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Máy in"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Khổ giấy"/>
                <ComboBox ItemsSource="{Binding MediaList}" SelectedItem="{Binding SelectedMedia}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Bảng ctb"/>
                <ComboBox ItemsSource="{Binding StyleSheets}" SelectedItem="{Binding SelectedStyleSheet}"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Chế độ"/>
                <WrapPanel>
                    <RadioButton Content="Theo khung" IsChecked="{Binding ModeFrames}" Margin="0,0,12,0" GroupName="OiMode"/>
                    <RadioButton Content="Vùng quét" IsChecked="{Binding ModeWindow}" Margin="0,0,12,0" GroupName="OiMode"/>
                    <RadioButton Content="Extents" IsChecked="{Binding ModeExtents}" GroupName="OiMode"/>
                </WrapPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Layer khung"/>
                <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" IsEnabled="{Binding ModeFrames}"/>

                <WrapPanel Margin="0,10,0,0">
                    <CheckBox Content="Gộp 1 file" IsChecked="{Binding Merge}" Margin="0,0,16,0"/>
                    <CheckBox Content="Mở sau khi in" IsChecked="{Binding OpenAfter}"/>
                </WrapPanel>
                </StackPanel>

                <!-- Tiến độ in: nhảy sau mỗi trang (CAD đang in một trang thì palette đứng im) -->
                <Border Margin="0,12,0,0" Visibility="{Binding ProgressVisibility}" Background="#FFFFFF"
                        BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="5" Padding="9,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressText}" Foreground="#1B5E20" FontSize="12" FontWeight="SemiBold"/>
                        <ProgressBar Height="10" Margin="0,6,0,0" Minimum="0" Maximum="{Binding ProgressMax}"
                                     Value="{Binding ProgressValue}" Foreground="{Binding AccentBrush}" Background="#E8F5E9"
                                     BorderThickness="0"/>
                        <Button Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource WhiteIconBtnStyle}"
                                Padding="14,4" Content="Huỷ" Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0" Visibility="{Binding FramesButtonsVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtnStyle}" Background="{Binding AccentBrush}"
                            Content="In tất cả khung" Command="{Binding PrintAllCommand}"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryBtnStyle}" Background="{Binding AccentBrush}"
                            Content="Chọn khung để in" Command="{Binding PickFramesCommand}"/>
                </Grid>
                <Button Margin="0,12,0,0" Visibility="{Binding PrintButtonVisibility}" Style="{StaticResource PrimaryBtnStyle}"
                        Background="{Binding AccentBrush}" Content="In" Command="{Binding PrintCommand}"/>

                <TextBlock Visibility="{Binding StatusVisibility}" Text="{Binding StatusText}" Foreground="#52606D"
                           FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
