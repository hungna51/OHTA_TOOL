<UserControl x:Class="OhtaTool.Plugin.Views.ModuleTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- Nút bấm trên thanh tác vụ nhỏ gọn -->
        <Style x:Key="ToolbarActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CFD8DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thẻ nút công cụ kiểu Tool Palette hiện đại -->
        <Style x:Key="ToolCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="#FFFFFF"
                                BorderBrush="#DCE3EA"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F0F7FF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#64B5F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header nhận diện theo màu nhóm -->
        <Border Grid.Row="0"
                Background="{Binding AccentBrush}"
                Padding="12,10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right"
                            Background="#33000000"
                            CornerRadius="3"
                            Padding="6,2"
                            VerticalAlignment="Top"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding FolderName}"
                                   Foreground="#FFFFFF"
                                   FontFamily="Consolas"
                                   FontSize="10.5"/>
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               Foreground="#FFFFFF"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{Binding Description}"
                           Foreground="#E8F4FD"
                           FontSize="11.5"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2. Thanh tìm kiếm & Thao tác nhanh của nhóm -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E0E6ED"
                BorderThickness="0,0,0,1"
                Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ô lọc nhanh lệnh trong Tab -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#CFD8DC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="11"
                                   Foreground="#78909C"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 Foreground="#263238"
                                 ToolTip="Nhập tên công cụ hoặc lệnh tắt để lọc nhanh trong nhóm này"/>
                        <Button Grid.Column="2"
                                Content="✕"
                                Visibility="{Binding ClearSearchVisibility}"
                                Command="{Binding ClearSearchCommand}"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#78909C"
                                FontSize="11"
                                Padding="4,0"
                                Cursor="Hand"
                                ToolTip="Xóa từ khóa lọc"/>
                    </Grid>
                </Border>

                <!-- Cụm nút mở nhanh MD / Rules / Thư mục & Làm mới Tab -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarActionBtnStyle}"
                            Content="📄 MD"
                            Command="{Binding OpenReadmeCommand}"
                            ToolTip="Mở file tài liệu .md đặc tả của nhóm này"/>
                    <Button Style="{StaticResource ToolbarActionBtnStyle}"
                            Content="⚖ Rules"
                            Command="{Binding OpenRulesFolderCommand}"
                            ToolTip="Mở thư mục rules/ riêng của nhóm này"/>
                    <Button Style="{StaticResource ToolbarActionBtnStyle}"
                            Content="📁"
                            Command="{Binding OpenModuleFolderCommand}"
                            ToolTip="Mở thư mục của mục con này trong Windows Explorer"/>
                    <Button Style="{StaticResource ToolbarActionBtnStyle}"
                            Content="⟳"
                            FontWeight="Bold"
                            Command="{Binding ReloadTabsCommand}"
                            ToolTip="Quét lại thư mục OHTA_TOOL/ và cập nhật toàn bộ Tab + Công cụ (OHTARELOAD)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Cảnh báo lỗi module.json (nếu có) -->
        <Border Grid.Row="2"
                Visibility="{Binding WarningVisibility}"
                Background="#FFF3E0"
                BorderBrush="#FFB74D"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <TextBlock Text="{Binding LoadWarning}"
                       Foreground="#E65100"
                       FontSize="11.5"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 4. Vùng cuộn danh sách nút công cụ của mục con -->
        <ScrollViewer x:Name="MainScroller"
                      Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10,10,10,6">
            <StackPanel>
                <!-- Danh sách nút lệnh -->
                <ItemsControl ItemsSource="{Binding FilteredTools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}"
                                    Command="{Binding DataContext.ExecuteToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.ToolTip>
                                    <StackPanel MaxWidth="320">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5"/>
                                        <TextBlock Text="{Binding Command, StringFormat='Lệnh CAD: {0}'}"
                                                   FontFamily="Consolas"
                                                   Foreground="#1565C0"
                                                   Margin="0,2,0,3"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11.5"/>
                                    </StackPanel>
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Badge vuông bo góc -->
                                    <Border Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Badge}"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="Bold"
                                                   FontSize="11.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Tên & mô tả ngắn -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#1F2933"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#616E7C"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Nhãn lệnh tắt bên phải -->
                                    <Border Grid.Column="2"
                                            Background="#EEF2F6"
                                            BorderBrush="#CBD2D9"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Command}"
                                                   Foreground="#334E68"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Trạng thái rỗng khi mục con mới tạo chưa có công cụ -->
                <Border Visibility="{Binding EmptyStateVisibility}"
                        Background="#FFFFFF"
                        BorderBrush="#CBD2D9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,18"
                        Margin="0,6,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🧰 Nhóm đang chờ bổ sung chức năng"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#334E68"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="1. Đặt file .lsp của nhóm vào thư mục lisp/&#x0a;2. Khai báo nút lệnh vào file module.json&#x0a;3. Bấm nút ⟳ ở góc trên phải để hiện công cụ ngay lập tức."
                                   FontSize="11.5"
                                   Foreground="#616E7C"
                                   LineHeight="18"
                                   Margin="0,8,0,12"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource ToolbarActionBtnStyle}"
                                    Content="📁 Mở thư mục nhóm"
                                    Command="{Binding OpenModuleFolderCommand}"/>
                            <Button Style="{StaticResource ToolbarActionBtnStyle}"
                                    Content="📄 Xem README.md"
                                    Command="{Binding OpenReadmeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Trạng thái không khớp từ khóa tìm kiếm -->
                <Border Visibility="{Binding NoFilterMatchVisibility}"
                        Padding="12,18">
                    <TextBlock Text="Không tìm thấy công cụ nào khớp từ khóa lọc."
                               Foreground="#7B8794"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 5. Thanh trạng thái chân Tab -->
        <Border Grid.Row="4"
                Background="#ECEFF1"
                BorderBrush="#CFD8DC"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding StatusSummary}"
                       Foreground="#455A64"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>

