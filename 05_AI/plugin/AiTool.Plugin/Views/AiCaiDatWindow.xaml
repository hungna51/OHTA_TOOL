<Window x:Class="AiTool.Views.AiCaiDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài Đặt AI"
        Width="720" Height="640" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Tab AI (ADR 0006): API key + file huong dan AI chay. Chi ghi file trong 05_AI\data, khong dung ban ve -->
    <Window.Resources>
        <Style x:Key="NutPhu" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource NutPhu}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- API key -->
        <Border Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="API KEY (ANTHROPIC)" Style="{StaticResource TieuDeThe}"/>
                <TextBlock x:Name="TrangThaiKey" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="NutXoaKey" Style="{StaticResource NutPhu}" Content="Xoá key"
                            Margin="6,0,0,0" Click="XoaKey"/>
                    <PasswordBox x:Name="KeyMoi" Padding="4,3" VerticalContentAlignment="Center"
                                 ToolTip="Dán key mới (bắt đầu bằng sk-ant-) rồi bấm Lưu. Để trống = giữ key cũ."/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#7B8794" Margin="0,6,0,0">
                    <Run Text="Dán key mới rồi bấm Lưu (để trống = giữ key cũ). Key lưu ở"/>
                    <Run x:Name="DuongDanKey" FontFamily="Consolas"/>
                    <Run Text="— không lên git. Chưa có key:"/>
                    <Hyperlink Click="MoConsole">console.anthropic.com</Hyperlink>
                    <Run Text="→ API Keys → Create Key (xem README của tab)."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- File huong dan AI -->
        <Border Grid.Row="1" Style="{StaticResource The}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FILE HƯỚNG DẪN AI CHẠY" Style="{StaticResource TieuDeThe}"/>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#7B8794" Margin="0,0,0,8">
                    <Run Text="AI đọc file này trước mỗi lần kiểm: vai trò, cách đọc dữ liệu khung, luật F-name, nhóm lỗi cần kiểm. Sửa ở đây hoặc mở bằng Notepad —"/>
                    <Run x:Name="DuongDanHuongDan" FontFamily="Consolas"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource NutPhu}" Content="Mở bằng Notepad" Click="MoNotepad" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource NutPhu}" Content="Khôi phục mặc định" Click="KhoiPhuc"/>
                </StackPanel>
                <TextBox x:Name="HuongDan" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Meiryo UI" FontSize="12" Padding="4"/>
            </DockPanel>
        </Border>

        <!-- OK / Huy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="NutLuu" Style="{StaticResource NutChinh}" Content="Lưu" IsDefault="True" Click="Luu" Margin="0,0,8,0"/>
            <Button Style="{StaticResource NutPhu}" Content="Huỷ" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
