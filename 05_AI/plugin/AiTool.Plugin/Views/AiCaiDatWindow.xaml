<Window x:Class="AiTool.Views.AiCaiDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài Đặt AI (Kev + Claude + Ling)"
        Width="740" Height="840" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NutPhu" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource NutPhu}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Kev Server (Local / LAN) -->
        <Border Grid.Row="0" Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="KEV-0.8B SERVER (PHÂN LOẠI TẤM GIA CÔNG &amp; LỌC HYBRID — LOCAL / LAN)" Style="{StaticResource TieuDeThe}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Content="▶ Bật Kev Server (Máy này)"
                            Margin="6,0,0,0" Click="BatKevLocal"
                            ToolTip="Khởi chạy 05_AI\kev\start_kev_server.bat trên cổng 8008"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Content="Kiểm tra kết nối"
                            Margin="6,0,0,0" Click="KiemTraKev"/>
                    <TextBox x:Name="KevUrlBox" Padding="6,4" VerticalContentAlignment="Center" FontFamily="Consolas"
                             ToolTip="Địa chỉ Kev Server (máy này: http://127.0.0.1:8008; máy khác trong LAN: http://192.168.x.x:8008)"/>
                </DockPanel>
                <TextBlock x:Name="TrangThaiKev" Foreground="#52606D" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Mặc định máy này: http://127.0.0.1:8008 · Máy khác trong mạng LAN nhập http://&lt;IP_máy_chủ&gt;:8008"/>
            </StackPanel>
        </Border>

        <!-- 1. API key (Anthropic) -->
        <Border Grid.Row="1" Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="API KEY (ANTHROPIC CLAUDE — DÙNG CHO HYBRID &amp; CHỈ CLAUDE)" Style="{StaticResource TieuDeThe}"/>
                <TextBlock x:Name="TrangThaiKey" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="NutXoaKey" Style="{StaticResource NutPhu}" Content="Xoá key"
                            Margin="6,0,0,0" Click="XoaKey"/>
                    <PasswordBox x:Name="KeyMoi" Padding="4,3" VerticalContentAlignment="Center"
                                 ToolTip="Dán key mới (bắt đầu bằng sk-ant-) rồi bấm Lưu. Để trống = giữ key cũ."/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#7B8794" Margin="0,6,0,0">
                    <Run Text="Dán key mới rồi bấm Lưu (để trống = giữ key cũ). Key lưu ở"/>
                    <Run x:Name="DuongDanKey" FontFamily="Consolas"/>
                    <Run Text="— không lên git. Chưa có key:"/>
                    <Hyperlink Click="MoConsole">console.anthropic.com</Hyperlink>
                    <Run Text="→ API Keys → Create Key (xem README của tab)."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 2. Ling API (man hinh chat) -->
        <Border Grid.Row="2" Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="LING API (CHAT VỚI AI — NÚT 💬 CHAT TRÊN TAB)" Style="{StaticResource TieuDeThe}"/>
                <TextBlock x:Name="TrangThaiLing" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="NutXoaLing" Style="{StaticResource NutPhu}" Content="Xoá key"
                            Margin="6,0,0,0" Click="XoaKeyLing"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Content="Kiểm tra kết nối"
                            Margin="6,0,0,0" Click="KiemTraLing"/>
                    <PasswordBox x:Name="LingKeyMoi" Padding="4,3" VerticalContentAlignment="Center"
                                 ToolTip="Dán key Ling (vd. sk-studio-...) rồi bấm Lưu. Để trống = giữ key cũ."/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="LingModelBox" Padding="6,4" VerticalContentAlignment="Center" FontFamily="Consolas"
                             ToolTip="Tên model Ling (mặc định Ling-3.2-flash). Model cũ bị ngừng thì gõ tên mới."/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#7B8794" Margin="0,6,0,0">
                    <Run Text="Key lưu ở"/>
                    <Run x:Name="DuongDanLing" FontFamily="Consolas"/>
                    <Run Text="— không lên git."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 3. File huong dan AI (Kev .md phan tang + Claude) -->
        <Border Grid.Row="3" Style="{StaticResource The}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="BỘ FILE HƯỚNG DẪN &amp; LUẬT AI (KEV PHÂN TẦNG .MD + CLAUDE)" Style="{StaticResource TieuDeThe}"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Chọn file:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ChonFileHuongDan" SelectionChanged="DoiFileHuongDan" Padding="6,4"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#7B8794" Margin="0,0,0,8">
                    <Run Text="Kev đọc từ 00-index.md dẫn sang các file .md con (đồng bộ sang cả Claude). Đường dẫn:"/>
                    <Run x:Name="DuongDanHuongDan" FontFamily="Consolas"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource NutPhu}" Content="Mở bằng Notepad" Click="MoNotepad" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource NutPhu}" Content="Mở thư mục data\kev" Click="MoThuMucKev" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource NutPhu}" Content="Khôi phục mặc định" Click="KhoiPhuc"/>
                </StackPanel>
                <TextBox x:Name="HuongDan" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Meiryo UI" FontSize="12" Padding="4"/>
            </DockPanel>
        </Border>

        <!-- 4. OK / Huy -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="NutLuu" Style="{StaticResource NutChinh}" Content="Lưu" IsDefault="True" Click="Luu" Margin="0,0,8,0"/>
            <Button Style="{StaticResource NutPhu}" Content="Huỷ" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
