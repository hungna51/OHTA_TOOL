<UserControl x:Class="AiTool.Views.AiTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AllowDrop="True" Focusable="True">
    <!-- Tab "Tao du lieu DXF tu anh" (ADR 0006): OhtaTeams.exe (thu nhanh chay an) doc + ve, tab chi xem va chen DXF -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HienKhi"/>

        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: cung kieu tab Fname / Guro. Nut ⚙ mo cua so Thu nhanh cua OhtaTeams (thu vien mau, AI viet mau) -->
        <Border Grid.Row="0" Background="{Binding AccentBrush}" Padding="12,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding ThuNhanhCmd}"
                        Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                        ToolTip="Mở cửa sổ Thử nhanh của OhtaTeams: 📚 Thư viện mẫu, ✨ AI viết mẫu, ➕ Thêm vào thư viện (máy Admin). Cài đặt AI: OhtaTeams → ⚙ → 🤖 AI">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Rectangle Width="18" Height="18" Fill="{Binding AccentBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding SettingsLogo}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TieuDe}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#DDD6FE" FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="KhungCuon" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <!-- Nhan anh -->
                <WrapPanel>
                    <Button x:Name="NutDan" Style="{StaticResource NutChinh}" Content="📋 Dán ảnh (Ctrl+V)" Command="{Binding DanCmd}"
                            IsEnabled="{Binding KhongChay}" ToolTip="Ảnh chụp MỘT hình (Win+Shift+S) hoặc tệp đã copy trong Explorer. Kéo thả tệp vào tab cũng được."/>
                    <Button Style="{StaticResource Nut}" Content="📂 Chọn tệp" Command="{Binding ChonTepCmd}" IsEnabled="{Binding KhongChay}"
                            ToolTip="Ảnh / PDF / DXF của MỘT hình"/>
                    <Button Style="{StaticResource Nut}" Content="■ Huỷ" Command="{Binding HuyCmd}"
                            Visibility="{Binding DangChay, Converter={StaticResource HienKhi}}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Bao}" TextWrapping="Wrap" Foreground="#5B3FD1" Margin="2,0,0,8"/>

                <!-- Lan thu dang chon -->
                <Border Style="{StaticResource The}" Visibility="{Binding CoChon, Converter={StaticResource HienKhi}}">
                    <StackPanel>
                        <TextBlock Text="{Binding TieuDeChon}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ChiTietChon}" Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <UniformGrid Columns="2">
                            <Border BorderBrush="#E1E4E8" BorderThickness="1" Margin="0,0,4,0" ToolTip="Ảnh gửi vào (bấm mở to)" Cursor="Hand" MouseLeftButtonUp="MoAnhGoc">
                                <Image Source="{Binding AnhGoc}" Stretch="Uniform" MaxHeight="220"/>
                            </Border>
                            <Border BorderBrush="#E1E4E8" BorderThickness="1" Margin="4,0,0,0" ToolTip="Hình phần mềm vẽ (bấm mở to)" Cursor="Hand" MouseLeftButtonUp="MoAnhVe">
                                <Image Source="{Binding AnhVe}" Stretch="Uniform" MaxHeight="220"/>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding LoiChon, StringFormat=✖ {0}}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding CoLoi, Converter={StaticResource HienKhi}}"/>
                        <TextBlock Text="{Binding CanhBaoChon}" Foreground="#B54708" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding CoCanhBao, Converter={StaticResource HienKhi}}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="NutChen" Style="{StaticResource NutChinh}" Content="📥 Chèn vào bản vẽ" Command="{Binding ChenCmd}"
                                    IsEnabled="{Binding CoDxf}" ToolTip="Lệnh OHTADXFCHEN: bấm điểm đặt góc dưới trái biên dạng. Chỉ hình + dim — F-name tự thêm."/>
                            <Button Style="{StaticResource Nut}" Content="✨ AI viết mẫu" Command="{Binding VietMauCmd}" IsEnabled="{Binding CoTheSua}"
                                    Visibility="{Binding CanMau, Converter={StaticResource HienKhi}}"
                                    ToolTip="Thư viện chưa có mẫu cho hình này: AI viết mẫu Python (mẫu thử của lần thử này) rồi vẽ lại — tốn AI. Thêm vào thư viện chung ở ⚙ (máy Admin)."/>
                            <Button Style="{StaticResource Nut}" Content="🔁 Vẽ lại" Command="{Binding VeLaiCmd}" IsEnabled="{Binding CoTheSua}"
                                    ToolTip="Vẽ lại từ thông số hiện tại (sau khi ✎ sửa) — không gọi AI"/>
                            <Button Style="{StaticResource Nut}" Content="🤖 Đọc lại (AI)" Command="{Binding DocLaiCmd}" IsEnabled="{Binding CoTheSua}"
                                    ToolTip="AI đọc lại hình rồi vẽ — tốn AI"/>
                            <Button Style="{StaticResource Nut}" Content="✎ Sửa thông số" Command="{Binding SuaCmd}" IsEnabled="{Binding CoTheSua}"
                                    ToolTip="Mở chi_tiet.json bằng Notepad: sửa bien_dang, kích thước, lo, ke_gaki, goc, khoet, dim_khach… rồi lưu và bấm 🔁 Vẽ lại"/>
                            <Button Style="{StaticResource Nut}" Content="📁 Thư mục" Command="{Binding ThuMucCmd}" IsEnabled="{Binding CoChon}"/>
                            <Button Style="{StaticResource Nut}" Content="🗑 Xoá" Command="{Binding XoaCmd}" IsEnabled="{Binding CoTheSua}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Danh sach lan thu -->
                <Border Style="{StaticResource The}">
                    <StackPanel>
                        <TextBlock Text="CÁC LẦN THỬ" Style="{StaticResource TieuDeThe}"/>
                        <ListBox ItemsSource="{Binding DanhSach}" SelectedItem="{Binding DongChon}" BorderThickness="0" MaxHeight="360"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding AnhNho}" Width="60" Height="44" Stretch="Uniform" Margin="0,2,6,2"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Gio}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MoTa}" Foreground="#5F6B7A" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
