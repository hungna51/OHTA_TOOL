<UserControl x:Class="AiTool.Views.AiTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- Tab AI (ADR 0006): AI chi canh bao, khong sua ban ve -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HienKhi"/>

        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutPhu" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Foreground" Value="#323639"/>
            <Setter Property="Background" Value="#E4E7EC"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="KhungCuon" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <!-- Tieu de -->
            <Border x:Name="Header" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding TieuDe}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#E8E4FF" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Chon layer + model -->
            <Border Style="{StaticResource The}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Layer khung" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox Grid.Column="1" Margin="0,0,0,6" IsEditable="True"
                              ItemsSource="{Binding DanhSachLayer}"
                              Text="{Binding LayerKhung, UpdateSourceTrigger=LostFocus}"
                              DropDownOpened="LayerMo"/>
                    <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DanhSachModel}" SelectedItem="{Binding Model}"/>
                </Grid>
            </Border>

            <!-- Nut chay -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="NutKiemTra" Style="{StaticResource Nut}" Content="▶ Kiểm tra" Command="{Binding KiemTraCmd}"
                        IsEnabled="{Binding KhongChay}" ToolTip="Kiểm tra mọi khung trong bản vẽ (lệnh OHTAAI)"/>
                <Button Grid.Column="2" Style="{StaticResource NutPhu}" Content="⬚ Chọn vùng" Command="{Binding ChonVungCmd}"
                        IsEnabled="{Binding KhongChay}" ToolTip="Quét một vùng, chỉ kiểm các khung nằm trọn trong vùng (lệnh OHTAAIVUNG)"/>
                <Button Grid.Column="4" Style="{StaticResource NutPhu}" Content="■ Dừng" Command="{Binding DungCmd}"
                        Visibility="{Binding DangChay, Converter={StaticResource HienKhi}}"/>
            </Grid>

            <!-- Tien do + tong -->
            <TextBlock Text="{Binding TienDo}" Foreground="#5B3FD1" FontWeight="SemiBold" Margin="2,0,0,4"
                       Visibility="{Binding DangChay, Converter={StaticResource HienKhi}}"/>
            <DockPanel Margin="2,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Content="Nhật ký" Padding="6,2"
                        Command="{Binding MoNhatKyCmd}" Visibility="{Binding CoNhatKy, Converter={StaticResource HienKhi}}"/>
                <TextBlock Text="{Binding Tong}" Foreground="#5F6B7A" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Loi -->
            <ItemsControl ItemsSource="{Binding Loi}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FDECEC" BorderBrush="#F5C2C0" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                            <TextBlock Text="{Binding}" Foreground="#B42318" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Canh bao -->
            <CheckBox Content="Chỉ hiện 🔴" IsChecked="{Binding ChiHienDo}" Margin="2,0,0,6"/>
            <ItemsControl ItemsSource="{Binding CanhBaoHien}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource The}" Cursor="Hand" MouseLeftButtonUp="CanhBaoBam"
                                ToolTip="Bấm để zoom tới khung">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="{Binding Icon, Mode=OneWay}"/>
                                    <Run Text="{Binding TieuDe, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding LyDo}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#1F7A4D"
                                           Visibility="{Binding CoGoiY, Converter={StaticResource HienKhi}}">
                                    <Run Text="Gợi ý: "/>
                                    <Run Text="{Binding GoiY, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Loi dan -->
            <Expander Header="Lời dặn cho AI" Margin="0,8,0,0">
                <StackPanel Margin="0,6,0,0">
                    <TextBox Text="{Binding LoiDan, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" MinHeight="160" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Meiryo UI"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource NutPhu}" Content="Lưu" Command="{Binding LuuLoiDanCmd}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource NutPhu}" Content="Khôi phục mặc định" Command="{Binding KhoiPhucCmd}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
