(defun C:kee(/ osm ss leng  n C Record tamocs tam A d1 d2 d3 d4 )
  (vla-startundomark (vla-get-activedocument (vlax-get-acad-object)))
  (setq osm (getvar "osmode"))
  (setq oldlayer (getvar "CLAYER"))
  (setvar "CMDECHO" 1)
  (setq ss (ssget '((0 . "CIRCLE"))))
  (setq leng (sslength ss))
  (setq n 0)
  (repeat leng
   (setq C (ssname ss n)) 
   (setq Record (entget C))
   (setq tamocs (cdr (assoc 10 Record))) ;tam duong tron trong he ocs
   (setq tam (trans tamocs 0 1))
   (setq A (cdr (assoc 40 Record)))
   (setq d1 (polar tam (/ pi 2) A))
   (setq d2 (polar tam pi A))
   (setq d3 (polar tam (/ pi -2) A))
   (setq d4 (polar tam 0 A))
   (setvar "osmode" 0)
   (setvar "clayer" "3-Kegaki")
   (entdel C)
   (command "line" d1 d3 "")
   (command "line" d2 d4 "")
   (setq n (1+ n))
  )
  (setvar "osmode" osm)
  (setvar "clayer" oldlayer)
  (vla-endundomark (vla-get-activedocument (vlax-get-acad-object)))
  (princ)
  )