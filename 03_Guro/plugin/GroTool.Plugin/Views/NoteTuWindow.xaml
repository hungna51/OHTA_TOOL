<Window x:Class="ZwCadPlugin.Views.NoteTuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Từ khóa ghi chú — GURO"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Muc 196: them / sua / xoa mot tu khoa ghi chu (kieu hop thoai Fname) -->
    <Window.Resources>
        <Style x:Key="DialogSecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#323639"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="#323639" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="TxtTieuDe" Text="Thêm từ khóa ghi chú" Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold"/>
                <TextBlock Text="Cụm từ tiếng Nhật trên bản vẽ và nghĩa tiếng Việt ghi vào cột Ghi chú của tấm"
                           Foreground="#CFD8DC" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,12,16,4">
            <TextBlock Text="Cụm từ tiếng Nhật" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtJapanese" Height="26" FontSize="12" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="Ví dụ: ｹｶﾞｷ線, 裏面CPL, 皿モミ" Style="{StaticResource FieldHint}"/>

            <TextBlock Text="Ý nghĩa tiếng Việt" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtVietnamese" Height="26" FontSize="12" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="Nội dung hiện ở cột Ghi chú, ví dụ: khắc kegaki, mặt sau CPL" Style="{StaticResource FieldHint}"/>
        </StackPanel>

        <Border Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <Button x:Name="BtnXoa" DockPanel.Dock="Left" Style="{StaticResource DialogSecondaryBtnStyle}"
                        Content="Xóa" Foreground="#B91C1C" Click="Xoa_Click" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogSecondaryBtnStyle}" Content="Hủy" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DialogPrimaryBtnStyle}" Content="Lưu" IsDefault="True" Click="Luu_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
