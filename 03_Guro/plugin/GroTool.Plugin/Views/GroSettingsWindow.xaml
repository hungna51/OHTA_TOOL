<Window x:Class="ZwCadPlugin.Views.GroSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh số tấm + mã khắc"
        SizeToContent="Height" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Arial, sans-serif" FontSize="12"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CanhBao" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B45309"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <!-- ===================== KHUNG IN & VUNG ===================== -->
        <GroupBox Header="Khung in &amp; Vùng">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Layer khung bao:"/>
                    <ComboBox Grid.Column="1" x:Name="CboKhung"
                              ItemsSource="{Binding DsKhung}" SelectedItem="{Binding ChonKhung}"/>
                </Grid>
                <TextBlock Style="{StaticResource CanhBao}" Text="{Binding CanhBaoKhung}"/>

                <CheckBox Content="Tự động in nhanh PDF (theo khung bao)" IsChecked="{Binding UseInPdf}"/>
                <CheckBox Content="Tự động tạo khung bao (Khung_IN) theo cụm chi tiết" IsChecked="{Binding UseTaoKhung}"/>

                <CheckBox Content="Đánh số theo vùng (polyline)" IsChecked="{Binding UseVung}" Margin="0,10,0,4"/>
                <Grid IsEnabled="{Binding BatLayerVung}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Layer vùng:" Margin="18,0,0,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DsVung}" SelectedItem="{Binding ChonVung}"/>
                </Grid>
                <TextBlock Style="{StaticResource CanhBao}" Text="{Binding CanhBaoVung}"/>
            </StackPanel>
        </GroupBox>

        <!-- ===================== SAP XEP & MA KHAC (muc 122) ===================== -->
        <GroupBox Header="Sắp xếp cụm &amp; mã khắc">
            <StackPanel IsEnabled="{Binding BatSapXep}">
                <CheckBox IsChecked="{Binding XepCum}">
                    <TextBlock TextWrapping="Wrap" Text="Xếp cụm mirror / gia công sang cột phải + tách cặp mirror, tách va chạm khung in (tắt thì bỏ qua cả đặt mã khắc)"/>
                </CheckBox>
                <CheckBox Content="Đặt mã khắc + F-name vào trong hình (tấm đơn / mirror)" IsChecked="{Binding DatMk}"
                          IsEnabled="{Binding BatDatMk}" Margin="18,4,0,4"/>
                <!-- Muc 170: bo lua chon che do - chi con truot tu goc tren-trai, chay bang C# -->

                <TextBlock Text="Cần bật &quot;Tự động tạo khung bao (Khung_IN)&quot;." Foreground="#B45309"
                           FontStyle="Italic" Margin="0,2,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BatSapXep}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- ===================== XU LY NET ===================== -->
        <GroupBox Header="Xử lý nét">
            <StackPanel>
                <CheckBox Content="Bật chuyển layer nét (Continuous → 0-KAKOU, Center1 → 3-KEGAKI)"
                          IsChecked="{Binding UseXln}"/>
                <Grid IsEnabled="{Binding BatXln}" Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Layer gốc bản vẽ:" Margin="18,0,0,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DsXln}" SelectedItem="{Binding ChonXln}"/>
                </Grid>

                <GroupBox Header="Lọc nét gióng kích thước (Dim → 1-SUNPOU)" Background="#F9FAFB" Margin="0,4,0,8">
                    <StackPanel>
                        <CheckBox Content="Tự động nhận diện nét Dim theo hình học (Dài, Lỗ, Góc)" IsChecked="{Binding AutoDim}"
                                  IsEnabled="{Binding BatXln}"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Pick nét mẫu" Style="{StaticResource Nut}"
                                    IsEnabled="{Binding BatChonMau}" Click="PickNet_Click"/>
                            <Button DockPanel.Dock="Right" Content="Chọn màu CAD..." Style="{StaticResource Nut}"
                                    IsEnabled="{Binding BatChonMau}" Click="ChonMau_Click"/>
                            <Border Width="14" Height="14" Margin="0,0,8,0" BorderBrush="#6B7280" BorderThickness="1"
                                    x:Name="OMau"/>
                            <TextBlock Text="{Binding NhanMau}"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <Button Content="Cài đặt ghi chú..." HorizontalAlignment="Left"
                        Padding="10,4" Margin="0,2,0,2" Click="Setting_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- ===================== OK / CANCEL ===================== -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Style="{StaticResource Nut}" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource Nut}"/>
        </StackPanel>
    </StackPanel>
</Window>
