<UserControl x:Class="ZwCadPlugin.Views.NoteDictionaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI" FontSize="12"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Muc 195/196: tu dien ghi chu Nhat -> Viet, kieu bang "Danh sach goc be thu" cua Fname.
         Dung chung cho tab Ghi chu (cai dat GURO) va hop thoai NoteDictionaryWindow (bang DST);
         noi chua dat cac nut Them / Khoi phuc / Luu o thanh day. -->
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NutNho" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0. Tim -->
            <RowDefinition Height="Auto"/>   <!-- 1. Google Sheet -->
            <RowDefinition Height="*"/>      <!-- 2. Bang -->
            <RowDefinition Height="Auto"/>   <!-- 3. Dem / trang thai -->
        </Grid.RowDefinitions>

        <!-- 0. Tim -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tìm" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtTim" Grid.Column="1" Height="25" VerticalContentAlignment="Center"
                     TextChanged="TxtTim_TextChanged"
                     ToolTip="Lọc theo cụm từ tiếng Nhật hoặc ý nghĩa tiếng Việt (nhiều từ cách nhau dấu cách)"/>
        </Grid>

        <!-- 1. Google Sheet: mot thanh manh -->
        <Border Grid.Row="1" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="5"
                Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Google Sheet" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtSheetUrl" Height="25" VerticalContentAlignment="Center"
                             ToolTip="Dán link Google Apps Script Web App hoặc Google Sheet công khai"/>
                    <Button Grid.Column="2" x:Name="BtnSync" Content="⬇ Tải" Style="{StaticResource NutNho}"
                            Margin="6,0,0,0" Click="DongBoSheet_Click" ToolTip="Tải từ điển mới nhất từ Google Sheet về máy"/>
                    <Button Grid.Column="3" x:Name="BtnUpload" Content="⬆ Đẩy" Style="{StaticResource NutNho}"
                            Margin="4,0,0,0" Click="DayLenSheet_Click" ToolTip="Đẩy từ điển hiện tại lên Google Sheet"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock x:Name="LblCapNhat" Margin="0,0,16,0" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"
                               ToolTip="Lần mở tab Guro đầu tiên trong ngày tự tải từ điển từ Google Sheet; bấm ⬇ Tải để tải ngay"/>
                    <CheckBox x:Name="ChkAutoUpload" Content="Tự đẩy khi lưu" Foreground="#334E68"
                              Checked="AutoUpload_Changed" Unchecked="AutoUpload_Changed"
                              ToolTip="Tự đẩy từ điển lên Google Sheet mỗi khi lưu"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Bang chi xem: bam dup de sua -->
        <DataGrid x:Name="DgrDictionary" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  RowHeaderWidth="0" FontSize="12" Background="#FFFFFF" BorderBrush="#CBD2D9"
                  SelectionMode="Single" AlternatingRowBackground="#F8FAFC"
                  MouseDoubleClick="Dgr_MouseDoubleClick"
                  ToolTip="Bấm đúp một dòng để sửa hoặc xóa">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cụm từ tiếng Nhật" Binding="{Binding Japanese}" Width="240"/>
                <DataGridTextColumn Header="Ý nghĩa tiếng Việt (Ghi chú)" Binding="{Binding Vietnamese}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 3. Dem -->
        <TextBlock x:Name="LblStatus" Grid.Row="3" FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
