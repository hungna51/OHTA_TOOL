<UserControl x:Class="ZwCadPlugin.Views.GuroTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- Muc 192/194: mat tab chi chon layer cho ban ve dang mo; cai dat chung o nut cai dat -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HienKhi"/>

        <Style x:Key="NutChinh" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#486581"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="GiaiThich" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#7B8794"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0. Header -->
            <RowDefinition Height="*"/>      <!-- 1. Chon layer (cuon) -->
            <RowDefinition Height="Auto"/>   <!-- 2. Nut chay -->
            <RowDefinition Height="Auto"/>   <!-- 3. Trang thai -->
        </Grid.RowDefinitions>

        <!-- 0. Header: nut cai dat cung kieu cac tab khac -->
        <Border Grid.Row="0" Background="{Binding AccentBrush}" Padding="12,10">
            <DockPanel LastChildFill="True">
                <!-- Nen trang nhu nut cai dat Fname; banh rang to theo mau tab -->
                <Button DockPanel.Dock="Right" Command="{Binding CaiDatCommand}"
                        Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                        ToolTip="Cài đặt GURO: khung tấm, in PDF, xếp cụm, mã khắc, xử lý nét">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#CFD8DC"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#CFD8DC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Rectangle Width="18" Height="18" Fill="{Binding AccentBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding SettingsLogo}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TieuDe}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#CFD8DC" FontSize="10.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Layer cho ban ve dang mo -->
        <ScrollViewer x:Name="KhungCuon" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,0">
            <StackPanel>
                <Border Style="{StaticResource The}">
                    <StackPanel>
                        <TextBlock Text="LAYER KHUNG BAO" Style="{StaticResource TieuDeThe}"/>
                        <TextBlock Style="{StaticResource GiaiThich}"
                                   Text="Polyline chữ nhật bao vùng bản vẽ cần đánh số. GRO chỉ lấy chữ nằm trong khung."/>
                        <ComboBox ItemsSource="{Binding DsKhung}" SelectedItem="{Binding ChonKhung}"
                                  PreviewMouseLeftButtonDown="OChon_PreviewMouseLeftButtonDown"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource The}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding UseVung}" Margin="0,0,0,4">
                            <TextBlock Text="ĐÁNH SỐ THEO VÙNG" FontSize="11" FontWeight="Bold" Foreground="#486581"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource GiaiThich}"
                                   Text="Polyline kín chia khung bao thành nhiều vùng. GRO đánh số xong vùng này mới sang vùng khác."/>
                        <ComboBox ItemsSource="{Binding DsVung}" SelectedItem="{Binding ChonVung}"
                                  IsEnabled="{Binding UseVung}"
                                  PreviewMouseLeftButtonDown="OChon_PreviewMouseLeftButtonDown"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource The}" Visibility="{Binding UseXln, Converter={StaticResource HienKhi}}">
                    <StackPanel>
                        <TextBlock Text="LAYER GỐC" Style="{StaticResource TieuDeThe}"/>
                        <TextBlock Style="{StaticResource GiaiThich}"
                                   Text="Layer chứa nét vẽ gốc cần chuyển (Continuous → 0-KAKOU, Center1 → 3-KEGAKI)."/>
                        <ComboBox ItemsSource="{Binding DsXln}" SelectedItem="{Binding ChonXln}"
                                  PreviewMouseLeftButtonDown="OChon_PreviewMouseLeftButtonDown"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TomTat}" Foreground="#486581" FontSize="11" TextWrapping="Wrap"
                           Margin="2,0,2,8" ToolTip="Đổi ở nút ⚙ trên đầu tab"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Nut chay -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="8,7">
            <StackPanel>
                <Button Style="{StaticResource NutChinh}" Background="#323639" Content="▶  Chạy GRO"
                        Command="{Binding ChayGroCommand}" Margin="0,0,0,5"
                        ToolTip="Đánh số tấm với layer và cài đặt trên tab (lệnh GROCHAY)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource NutChinh}" Background="#546E7A" Content="GI — In lại PDF"
                            Command="{Binding ChayGiCommand}"
                            ToolTip="Chọn vùng, in lại PDF như cuối lệnh GRO"/>
                    <Button Grid.Column="2" Style="{StaticResource NutChinh}" Background="#546E7A" Content="DST — Danh sách"
                            Command="{Binding MoDstCommand}"
                            ToolTip="Xem, sửa tấm và nét chưa đổi"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Trang thai -->
        <Border Grid.Row="3" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding TrangThai}" Foreground="#455A64" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
