<UserControl x:Class="ZwCadPlugin.Views.GuroTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- Muc 192: thiet lap lenh GRO nam ngay tren bang OHTA (giong tab Fname), doi la luu registry -->
    <UserControl.Resources>
        <Style x:Key="NutNho" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#78909C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CFD8DC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutChinh" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#486581"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style x:Key="NhanO" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Canh bao do: layer da chon khong co trong ban ve (an khi khong co chu) -->
        <Style x:Key="CanhBao" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0. Header -->
            <RowDefinition Height="*"/>      <!-- 1. The thiet lap (cuon) -->
            <RowDefinition Height="Auto"/>   <!-- 2. Nut chay -->
            <RowDefinition Height="Auto"/>   <!-- 3. Trang thai -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="{Binding AccentBrush}" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding TieuDe}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#CFD8DC" FontSize="10.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource NutNho}" Content="↻" FontSize="14"
                        Width="30" Height="30" Padding="0"
                        Command="{Binding LamMoiCommand}"
                        ToolTip="Đọc lại layer của bản vẽ đang mở và thiết lập đã lưu"/>
            </Grid>
        </Border>

        <!-- 1. Thiet lap -->
        <ScrollViewer x:Name="KhungCuon" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,0">
            <StackPanel>

                <!-- KHUNG & VUNG -->
                <Border Style="{StaticResource The}">
                    <StackPanel>
                        <TextBlock Text="KHUNG &amp; VÙNG" Style="{StaticResource TieuDeThe}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Layer khung bao" Style="{StaticResource NhanO}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DsKhung}" SelectedItem="{Binding ChonKhung}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource CanhBao}" Text="{Binding CanhBaoKhung}"/>
                        <CheckBox Content="Tự tạo khung bao (Khung_IN) theo cụm" IsChecked="{Binding UseTaoKhung}"/>
                        <CheckBox Content="Tự in nhanh PDF theo khung bao" IsChecked="{Binding UseInPdf}"/>

                        <CheckBox Content="Đánh số theo vùng (polyline)" IsChecked="{Binding UseVung}" Margin="0,8,0,3"/>
                        <Grid IsEnabled="{Binding BatLayerVung}" Margin="18,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Layer vùng" Style="{StaticResource NhanO}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DsVung}" SelectedItem="{Binding ChonVung}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource CanhBao}" Text="{Binding CanhBaoVung}" Margin="18,2,0,2"/>
                    </StackPanel>
                </Border>

                <!-- XEP CUM & MA KHAC -->
                <Border Style="{StaticResource The}">
                    <StackPanel>
                        <TextBlock Text="XẾP CỤM &amp; MÃ KHẮC" Style="{StaticResource TieuDeThe}"/>
                        <StackPanel IsEnabled="{Binding BatSapXep}">
                            <CheckBox IsChecked="{Binding XepCum}">
                                <TextBlock TextWrapping="Wrap" Text="Xếp cụm mirror / gia công sang cột phải, tách cặp mirror"/>
                            </CheckBox>
                            <CheckBox Content="Đặt mã khắc + F-name vào trong hình" IsChecked="{Binding DatMk}"
                                      IsEnabled="{Binding BatDatMk}" Margin="18,3,0,3"/>
                        </StackPanel>
                        <TextBlock Text="Cần bật &quot;Tự tạo khung bao&quot;." Foreground="#B45309" FontStyle="Italic"
                                   FontSize="11" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BatSapXep}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- XU LY NET -->
                <Border Style="{StaticResource The}">
                    <StackPanel>
                        <TextBlock Text="XỬ LÝ NÉT" Style="{StaticResource TieuDeThe}"/>
                        <CheckBox IsChecked="{Binding UseXln}">
                            <TextBlock TextWrapping="Wrap" Text="Chuyển layer nét (Continuous → 0-KAKOU, Center1 → 3-KEGAKI)"/>
                        </CheckBox>
                        <Grid IsEnabled="{Binding BatXln}" Margin="18,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Layer gốc" Style="{StaticResource NhanO}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DsXln}" SelectedItem="{Binding ChonXln}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource CanhBao}" Text="{Binding CanhBaoXln}" Margin="18,2,0,2"/>

                        <TextBlock Text="Nét gióng kích thước (Dim → 1-SUNPOU)" Foreground="#486581" FontSize="11"
                                   Margin="0,8,0,2"/>
                        <CheckBox Content="Tự nhận diện theo hình học" IsChecked="{Binding AutoDim}"
                                  IsEnabled="{Binding BatXln}"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource NutNho}" Content="Pick nét"
                                    Margin="4,0,0,0" Command="{Binding PickNetCommand}"
                                    IsEnabled="{Binding BatChonMau}"
                                    ToolTip="Chọn một nét Dim mẫu trên bản vẽ để lấy màu"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource NutNho}" Content="Chọn màu..."
                                    Margin="4,0,0,0" Click="ChonMau_Click" IsEnabled="{Binding BatChonMau}"/>
                            <Border x:Name="OMau" Width="14" Height="14" Margin="0,0,6,0"
                                    BorderBrush="#6B7280" BorderThickness="1"/>
                            <TextBlock Text="{Binding NhanMau}" VerticalAlignment="Center" Foreground="#334E68"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <Button Style="{StaticResource NutNho}" Content="Cài đặt ghi chú..." HorizontalAlignment="Left"
                                Margin="0,8,0,0" Click="GhiChu_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Nut chay -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="8,7">
            <StackPanel>
                <Button Style="{StaticResource NutChinh}" Background="#323639" Content="▶  Chạy GRO"
                        Command="{Binding ChayGroCommand}" Margin="0,0,0,5"
                        ToolTip="Đánh số tấm theo thiết lập trên (không hiện hộp thoại)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource NutChinh}" Background="#546E7A" Content="GI — In lại PDF"
                            Command="{Binding ChayGiCommand}"
                            ToolTip="Chọn vùng, in lại PDF như cuối lệnh GRO"/>
                    <Button Grid.Column="2" Style="{StaticResource NutChinh}" Background="#546E7A" Content="DST — Danh sách"
                            Command="{Binding MoDstCommand}"
                            ToolTip="Xem, sửa tấm và nét chưa đổi"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Trang thai -->
        <Border Grid.Row="3" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding TrangThai}" Foreground="#455A64" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
