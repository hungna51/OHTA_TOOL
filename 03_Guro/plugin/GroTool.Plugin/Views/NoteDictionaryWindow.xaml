<Window x:Class="ZwCadPlugin.Views.NoteDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZwCadPlugin.Views"
        Title="Cài đặt ghi chú (Tiếng Nhật ➔ Tiếng Việt)"
        Width="700" Height="600" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Arial, sans-serif" FontSize="12"
        Background="#F3F4F6">
    <!-- Hop thoai rieng (bang DST mo). Noi dung nam o NoteDictionaryPanel (muc 195). -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <v:NoteDictionaryPanel x:Name="Panel"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="💾 Lưu &amp; Đóng" IsDefault="True" Padding="12,5" Margin="0,0,6,0" Click="Luu_Click"/>
            <Button Content="Đóng" IsCancel="True" Padding="12,5"/>
        </StackPanel>
    </Grid>
</Window>
