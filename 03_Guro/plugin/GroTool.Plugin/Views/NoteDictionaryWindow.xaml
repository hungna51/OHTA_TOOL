<Window x:Class="ZwCadPlugin.Views.NoteDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt ghi chú (Tiếng Nhật ➔ Tiếng Việt)"
        Width="700" Height="600" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Arial, sans-serif" FontSize="12"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SyncBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#065F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UploadBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Google Sheet Sync -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Add / Edit Box -->
            <RowDefinition Height="*"/>
            <!-- 3: DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="CÀI ĐẶT GHI CHÚ BẢN VẼ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Tự động nhận diện cụm từ tiếng Nhật trên bản vẽ và dịch sang tiếng Việt để ghi vào cột Ghi chú của tấm."
                           Foreground="#93C5FD" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ==================== ĐỒNG BỘ GOOGLE SHEET / SCRIPT ==================== -->
        <Border Grid.Row="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <!-- Dòng 1: Tiêu đề bên trái, 2 ô CheckBox bên phải căn chỉnh rộng rãi -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Link Google Sheet / Script:"
                               FontWeight="Bold" Foreground="#065F46" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkAutoSync" Content="Tự động tải về khi mở" Margin="0,0,18,0"
                                  VerticalAlignment="Center" Foreground="#047857" FontWeight="SemiBold"
                                  Checked="AutoSync_Changed" Unchecked="AutoSync_Changed"
                                  ToolTip="Tự động tải danh sách từ điển mới nhất từ Google Sheet khi mở cửa sổ"/>
                        <CheckBox x:Name="ChkAutoUpload" Content="Tự động đẩy lên khi Lưu" Margin="0"
                                  VerticalAlignment="Center" Foreground="#047857" FontWeight="SemiBold"
                                  Checked="AutoUpload_Changed" Unchecked="AutoUpload_Changed"
                                  ToolTip="Tự động đẩy từ khóa mới lên Google Sheet mỗi khi nhấn Lưu &amp; Đóng"/>
                    </StackPanel>
                </DockPanel>

                <!-- Dòng 2: Ô nhập link + 2 nút thao tác -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="TxtSheetUrl" Height="26" Margin="0,0,6,0"
                             VerticalContentAlignment="Center" Padding="4,0" Foreground="#065F46"
                             ToolTip="Dán đường link Google Apps Script Web App hoặc Google Sheet công khai"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnSync" Content="⬇ Tải từ Sheet" Style="{StaticResource SyncBtn}" Height="26"
                                Padding="12,0" Margin="2,0,2,0" Click="DongBoSheet_Click" ToolTip="Tải từ điển mới nhất từ Google Sheet về máy"/>
                        <Button x:Name="BtnUpload" Content="⬆ Đẩy lên Sheet" Style="{StaticResource UploadBtn}" Height="26"
                                Padding="12,0" Margin="2,0,0,0" Click="DayLenSheet_Click" ToolTip="Đẩy danh sách từ điển hiện tại ngược lên Google Sheet"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== FORM THÊM / CẬP NHẬT THỦ CÔNG ==================== -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Cụm từ tiếng Nhật (Katakana/Kanji/Romaji):" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,6,4"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtJapanese" Height="26" Margin="0,0,6,0" VerticalContentAlignment="Center" Padding="4,0"
                         ToolTip="Nhập từ khóa tiếng Nhật trên bản vẽ (ví dụ: ｹｶﾞｷ線, 裏面CPL, 皿モミ...)"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Ý nghĩa tiếng Việt (ghi vào Note):" FontWeight="SemiBold" Foreground="#374151" Margin="6,0,6,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtVietnamese" Height="26" Margin="6,0,6,0" VerticalContentAlignment="Center" Padding="4,0"
                         ToolTip="Nhập nội dung tiếng Việt hiển thị ở cột Ghi chú (ví dụ: khắc kegaki, Mặt sau CPL...)"/>

                <Button Grid.Row="1" Grid.Column="2" Content="➕ Thêm / Sửa" Style="{StaticResource PrimaryBtn}" Height="26"
                        Padding="12,0" Margin="6,0,0,0" Click="ThemTu_Click" ToolTip="Thêm từ khóa mới hoặc cập nhật từ khóa đã có"/>
            </Grid>
        </Border>

        <!-- ==================== DATAGRID DANH SÁCH ==================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <DataGrid x:Name="DgrDictionary" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent"
                      RowHeaderWidth="0" AlternatingRowBackground="#F9FAFB"
                      SelectionMode="Single" SelectionUnit="FullRow">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Tiếng Nhật -->
                    <DataGridTextColumn Header="Cụm từ tiếng Nhật" Binding="{Binding Japanese, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Tiếng Việt -->
                    <DataGridTextColumn Header="Ý nghĩa tiếng Việt (Ghi chú)" Binding="{Binding Vietnamese, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Nút Xóa -->
                    <DataGridTemplateColumn Header="Thao tác" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xóa" Style="{StaticResource DangerBtn}" Click="XoaDong_Click" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ==================== FOOTER ==================== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LblStatus" Grid.Column="0" VerticalAlignment="Center" Foreground="#4B5563" FontWeight="SemiBold"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⟲ Khôi phục mặc định" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Click="KhoiPhuc_Click"/>
                <Button Content="💾 Lưu &amp; Đóng" Style="{StaticResource PrimaryBtn}" IsDefault="True" Margin="0,0,6,0" Click="Luu_Click"/>
                <Button Content="Đóng" Style="{StaticResource ModernBtn}" IsCancel="True" Click="Dong_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
