<Window x:Class="ZwCadPlugin.Views.GuroCaiDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZwCadPlugin.Views"
        Title="Cài đặt GURO"
        Width="680" Height="620" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI" FontSize="12"
        Background="#F5F7FA">
    <!-- Muc 194/195: tab Chung (cai dat lenh GRO) + tab Ghi chu (tu dien Nhat-Viet); OK luu ca hai -->
    <Window.Resources>
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#486581"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Background="#F5F7FA">
            <TabItem Header="Chung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                    <Border Style="{StaticResource The}">
                        <StackPanel>
                            <TextBlock Text="KHUNG TẤM &amp; IN" Style="{StaticResource TieuDeThe}"/>
                            <CheckBox Content="Tự tạo khung tấm theo cụm" IsChecked="{Binding UseTaoKhung}"/>
                            <Grid Margin="20,2,0,2" IsEnabled="{Binding BatXepCum}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Layer" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#334E68"/>
                                <TextBox Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                         Text="{Binding LayerKhungTam, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Bản vẽ chưa có layer này thì GRO tự tạo. Để trống = Khung_IN"/>
                            </Grid>
                            <TextBlock Text="{Binding Loi}" Foreground="#C62828" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <CheckBox Content="Tự in nhanh PDF theo khung bao" IsChecked="{Binding UseInPdf}" Margin="0,6,0,3"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource The}">
                        <StackPanel>
                            <TextBlock Text="XẾP CỤM &amp; MÃ KHẮC" Style="{StaticResource TieuDeThe}"/>
                            <CheckBox IsChecked="{Binding XepCum}" IsEnabled="{Binding BatXepCum}">
                                <TextBlock TextWrapping="Wrap" Text="Xếp cụm mirror / gia công sang cột phải, tách cặp mirror"/>
                            </CheckBox>
                            <CheckBox Content="Đặt mã khắc + F-name vào trong hình" IsChecked="{Binding DatMk}"
                                      IsEnabled="{Binding BatDatMk}" Margin="20,3,0,3"/>
                            <TextBlock Text="Cần bật &quot;Tự tạo khung tấm&quot;." Foreground="#B45309" FontStyle="Italic" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatXepCum}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource The}">
                        <StackPanel>
                            <TextBlock Text="XỬ LÝ NÉT" Style="{StaticResource TieuDeThe}"/>
                            <CheckBox IsChecked="{Binding UseXln}">
                                <TextBlock TextWrapping="Wrap" Text="Chuyển layer nét (Continuous → 0-KAKOU, Center1 → 3-KEGAKI)"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AutoDim}" IsEnabled="{Binding UseXln}" Margin="20,3,0,3">
                                <TextBlock TextWrapping="Wrap" Text="Tự nhận diện nét Dim theo hình học → 1-SUNPOU (tắt = không xử lý nét Dim)"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Ghi chú">
                <v:NoteDictionaryPanel x:Name="PanelGhiChu" Margin="8"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource Nut}" Click="Ok_Click"
                    IsEnabled="{Binding DuocLuu}"/>
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource Nut}"/>
        </StackPanel>
    </Grid>
</Window>
