<Window x:Class="ZwCadPlugin.Views.GoogleSheetSyncSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt đồng bộ 2 chiều lên Google Sheet"
        Width="640" Height="580" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Arial, sans-serif" FontSize="12"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#065F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Banner -->
            <RowDefinition Height="*"/>
            <!-- 1: Body (Scrollable) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ĐỒNG BỘ NGƯỢC LÊN GOOGLE SHEET" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Cơ chế tự động đẩy ghi chú mới từ phần mềm lên Google Sheet để đồng bộ giữa các máy."
                           Foreground="#93C5FD" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ==================== BODY ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <!-- CÁCH 1: APPS SCRIPT WEB APP -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Cách 1: Đồng bộ tự động 1 chạm qua Apps Script (Khuyên dùng)"
                                       FontWeight="Bold" FontSize="12" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="🌐 Mở Google Sheet" Style="{StaticResource ModernBtn}"
                                    HorizontalAlignment="Right" Padding="8,3" Click="MoSheet_Click" ToolTip="Mở file Google Sheet trên trình duyệt"/>
                        </DockPanel>

                        <TextBlock Text="Google Sheets bảo vệ dữ liệu bằng cách không cho ghi ẩn danh trực tiếp. Chỉ cần thiết lập 1 Web App nhỏ (làm 1 lần duy nhất trong 1 phút):"
                                   Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Bước 1: Trên Google Sheet, vào menu: Tiện ích mở rộng ➔ Apps Script."
                                           Foreground="#374151" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Bước 2: Xóa code cũ, dán đoạn mã đồng bộ:" Foreground="#374151" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCopyCode" Content="📋 Sao chép mã Apps Script" Style="{StaticResource ModernBtn}"
                                            HorizontalAlignment="Right" Padding="8,2" FontSize="11" Click="CopyScriptCode_Click"/>
                                </DockPanel>
                                <TextBlock Text="Bước 3: Bấm 'Triển khai' (Deploy) ➔ 'Triển khai mới' (New deployment) ➔ chọn 'Ứng dụng web' (Web app):"
                                           Foreground="#374151" Margin="0,0,0,2"/>
                                <TextBlock Text="     • Thực thi dưới dạng: Tôi (Me)&#x0a;     • Ai có quyền truy cập: Bất kỳ ai (Anyone)"
                                           Foreground="#059669" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Bước 4: Bấm 'Triển khai', sao chép đường link Web App (dạng https://script.google.com/macros/s/.../exec) và dán vào ô bên dưới:"
                                           Foreground="#374151" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Đường link Web App (Apps Script):" FontWeight="SemiBold" Foreground="#374151" Margin="0,2,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtScriptUrl" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="Dán link Web App Apps Script vừa triển khai"/>
                            <Button Grid.Column="1" Content="💾 Lưu &amp; Đẩy lên ngay" Style="{StaticResource GreenBtn}" Height="26"
                                    Margin="6,0,0,0" Padding="12,0" Click="LuuScriptVaDay_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CÁCH 2: SAO CHÉP NHANH VÀO CLIPBOARD -->
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Cách 2: Sao chép nhanh vào bảng tính (Không cần cài Script)"
                                   FontWeight="Bold" FontSize="12" Foreground="#065F46" Margin="0,0,0,4"/>
                        <TextBlock Text="Nếu chưa muốn tạo Apps Script, bạn có thể sao chép nhanh toàn bộ bảng từ khóa vào bộ nhớ tạm rồi dán (Ctrl+V) thẳng vào cột A1 của Google Sheet."
                                   Foreground="#047857" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Button Content="📋 Sao chép bảng từ khóa &amp; Mở Google Sheet để dán (Ctrl+V)"
                                Style="{StaticResource GreenBtn}" HorizontalAlignment="Left" Padding="14,6" Click="CopyVaMoSheet_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="LblStatus" VerticalAlignment="Center" Foreground="#4B5563" FontWeight="SemiBold"/>
            <Button Content="Đóng" Style="{StaticResource ModernBtn}" HorizontalAlignment="Right" IsCancel="True" Click="Dong_Click"/>
        </Grid>
    </Grid>
</Window>
