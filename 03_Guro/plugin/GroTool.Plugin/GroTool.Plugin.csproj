<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ZwCadPlugin</RootNamespace>
    <AssemblyName>GROZWCAD</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Đảm bảo xuất DLL sạch vào thư mục bin -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cho phép biên dịch .NET 4.8 bằng .NET SDK hiện đại mà không cần cài đặt VS Developer Pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tham chiếu đến các thư viện cốt lõi của ZWCAD 2026 -->
    <Reference Include="ZwDatabaseMgd">
      <HintPath>C:\Program Files\ZWSOFT\ZWCAD 2026\ZwDatabaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ZwManaged">
      <HintPath>C:\Program Files\ZWSOFT\ZWCAD 2026\ZwManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <!-- Muc 179: DLL ten GROZWCAD.dll, thu muc rieng C:\GROZWCAD (lisp GRO nap khi mo ZWCAD) -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="C:\GROZWCAD" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="C:\GROZWCAD" Condition="Exists('$(TargetDir)$(TargetName).pdb')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(ProjectDir)..\GROZWCAD.dll" ContinueOnError="true" />
  </Target>
</Project>
