<Window x:Class="CsvTool.Views.CsvCaiDatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài Đặt CSV"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Cung kieu cua so cai dat tab AI (AiCaiDatWindow) -->
    <Window.Resources>
        <Style x:Key="NutPhu" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334E68"/>
            <Setter Property="BorderBrush" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource NutPhu}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TieuDeThe" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
        </Style>
        <Style x:Key="O" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <Border Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="THỨ TỰ TẤM TRONG CSV" Style="{StaticResource TieuDeThe}"/>
                <RadioButton x:Name="SxTraiPhai" GroupName="Sx" Content="Trái → phải" Margin="0,0,0,4"/>
                <RadioButton x:Name="SxTrenDuoi" GroupName="Sx" Content="Trên → dưới" Margin="0,0,0,4"/>
                <RadioButton x:Name="SxChuCai" GroupName="Sx" Content="Theo tên tấm"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="LAYER" Style="{StaticResource TieuDeThe}"/>
                <CheckBox x:Name="DungMacDinh" Margin="0,0,0,8" Checked="DoiMacDinh" Unchecked="DoiMacDinh"
                          Content="Dùng layer mặc định (Khung_IN · 1-XY · TAPU_TMT)"/>
                <Grid x:Name="LopTuChon">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Nhan}" Text="Layer khung in"/>
                    <TextBox x:Name="LopKhung" Grid.Column="1" Style="{StaticResource O}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Nhan}" Text="Layer dim tổng"/>
                    <TextBox x:Name="LopDim" Grid.Row="1" Grid.Column="1" Style="{StaticResource O}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Nhan}" Text="Layer tapu"/>
                    <TextBox x:Name="LopTapu" Grid.Row="2" Grid.Column="1" Style="{StaticResource O}" Margin="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource The}">
            <StackPanel>
                <TextBlock Text="XUẤT THÔNG TIN TẤM (HÌNH HỌC)" Style="{StaticResource TieuDeThe}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Nhan}" Text="Bước spline (mm)"/>
                    <TextBox x:Name="BuocSpline" Grid.Column="1" Style="{StaticResource O}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Nhan}" Text="Dung sai khe hở (mm)"/>
                    <TextBox x:Name="DungSai" Grid.Row="1" Grid.Column="1" Style="{StaticResource O}" Margin="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="Loi" Foreground="#C62828" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NutLuu" Style="{StaticResource NutChinh}" Content="Lưu" IsDefault="True" Click="Luu" Margin="0,0,8,0"/>
            <Button Style="{StaticResource NutPhu}" Content="Huỷ" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
