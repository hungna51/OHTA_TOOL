<UserControl x:Class="CsvTool.Views.CsvTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HienKhi"/>

        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutPhu" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Foreground" Value="#323639"/>
            <Setter Property="Background" Value="#E4E7EC"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
        </Style>
        <!-- o gia tri trong the tam: TextBox khong vien, Enter = ghi -->
        <Style x:Key="O" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="KeyDown" Handler="OPhim"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SuaDuoc}" Value="False">
                    <Setter Property="IsReadOnly" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Background" Value="#DDEBF7"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,1,1"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- thanh nut -->
            <RowDefinition Height="*"/>      <!-- danh sach tam -->
            <RowDefinition Height="Auto"/>   <!-- trang thai -->
        </Grid.RowDefinitions>

        <!-- Header: cung kieu tab AI / Guro, nut cai dat nen trang banh rang to mau tab -->
        <Border Grid.Row="0" Background="{Binding AccentBrush}" Padding="12,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding CaiDatCmd}"
                        Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                        ToolTip="Cài đặt CSV: thứ tự tấm, layer, bước spline, dung sai khe hở">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#CFD8DC"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#CFD8DC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Rectangle Width="18" Height="18" Fill="{Binding AccentBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding SettingsLogo}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TieuDe}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#E8F5E9" FontSize="10.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource The}">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="NutB1" Style="{StaticResource Nut}" Content="Xuất thông tin tấm" Command="{Binding B1Cmd}"
                            ToolTip="Phân tích hình học → ghi MText thông tin tấm (tạm chạy lisp cũ)"/>
                    <Button x:Name="NutExport" Style="{StaticResource Nut}" Content="EXPORT" Command="{Binding ExportCmd}"
                            ToolTip="Chọn khung in → ghi &lt;đơn&gt;.csv + data\&lt;đơn&gt;-data.csv (có tấm lỗi thì không ghi)"/>
                    <Button Style="{StaticResource NutPhu}" Content="Làm mới" Command="{Binding LamMoiCmd}"
                            ToolTip="Chọn khung in → đọc lại danh sách tấm (không ghi CSV)"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Chế độ tính:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton GroupName="CheDo" Content="0 bình thường" IsChecked="{Binding CheDo0}" Margin="0,0,10,0"/>
                    <RadioButton GroupName="CheDo" Content="1 chỉ gia công" IsChecked="{Binding CheDo1}" Margin="0,0,10,0"/>
                    <RadioButton GroupName="CheDo" Content="2 vật liệu khách" IsChecked="{Binding CheDo2}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource The}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="0" Content="{Binding NhanChiTiet}"
                            Command="{Binding ChiTietCmd}" ToolTip="Mở hoặc thu gọn mọi thẻ tấm"/>
                    <CheckBox Content="Chỉ tấm lỗi" IsChecked="{Binding ChiLoi}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer x:Name="Cuon" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                    <ItemsControl ItemsSource="{Binding DongHien}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 1 the tam: ten | 3 tang thong so | gia tien. Nen xam + khe 1px = vien o -->
                                <Border BorderBrush="#90A4AE" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6"
                                        Background="#CFD8DC" PreviewMouseLeftButtonDown="TheBam">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <DockPanel x:Name="OTen" Background="#E2F0D9" Margin="0,0,1,0">
                                            <TextBlock x:Name="Mui" DockPanel.Dock="Left" Text="▸" Width="18" Padding="5,0,0,0"
                                                       VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MuiBam"
                                                       ToolTip="Mở / thu gọn tấm này"/>
                                            <TextBox Style="{StaticResource O}" Text="{Binding N}" FontWeight="SemiBold" Background="Transparent"
                                                     TextWrapping="Wrap" HorizontalContentAlignment="Left" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Loi}" Foreground="#C62828" TextWrapping="Wrap" Padding="6,4"
                                                       Background="#FDECEA" Margin="0,0,1,1"
                                                       Visibility="{Binding CoLoi, Converter={StaticResource HienKhi}}"/>
                                            <StackPanel Visibility="{Binding SuaDuoc, Converter={StaticResource HienKhi}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/><ColumnDefinition Width="64"/><ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Style="{StaticResource Nhan}" Text="Q"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="M"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="T"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="X × Y"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="4" Text="Loại gia công"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Text="{Binding Q}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding M}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding T}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="3" Text="{Binding XxY, Mode=OneWay}" IsReadOnly="True"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="4" Text="{Binding LoaiGiaCong}"/>
                                                </Grid>
                                                <StackPanel x:Name="ChiTiet" Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Lỗ nhỏ"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Lỗ lớn"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Tapu &amp; sara"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="Pitchi số lần × dài"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="4" Text="Chiều dài vát"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Text="{Binding LoNho, Mode=OneWay}" IsReadOnly="True"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding LoLon, Mode=OneWay}" IsReadOnly="True"/>
                                                        <Grid Grid.Row="1" Grid.Column="2" Background="#FFFFFF" Margin="0,0,1,1">
                                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                            <TextBox Style="{StaticResource O}" Margin="0" Text="{Binding Tappu}" ToolTip="Lỗ Tappu"/>
                                                            <TextBlock Grid.Column="1" Text="&amp;" VerticalAlignment="Center"/>
                                                            <TextBox Style="{StaticResource O}" Grid.Column="2" Margin="0" Text="{Binding Sara}" ToolTip="Lỗ Sara"/>
                                                        </Grid>
                                                        <Grid Grid.Row="1" Grid.Column="3" Background="#FFFFFF" Margin="0,0,1,1">
                                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                            <TextBox Style="{StaticResource O}" Margin="0" Text="{Binding PitchiSoLan}" ToolTip="Pitchi - Số lần"/>
                                                            <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center"/>
                                                            <TextBox Style="{StaticResource O}" Grid.Column="2" Margin="0" Text="{Binding PitchiDai}" ToolTip="Pitchi - Chiều dài (mm)"/>
                                                        </Grid>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="4" Text="{Binding Vat}"/>
                                                    </Grid>
                                                    <StackPanel Visibility="{Binding CoDuongBe, Converter={StaticResource HienKhi}}">
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Đường bẻ: số đường × chiều dài" TextAlignment="Center"/>
                                                        <TextBlock Text="{Binding DuongBe}" Background="#FFFFFF" Padding="6,3" Margin="0,0,1,0"
                                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <DockPanel Grid.Column="2" Background="#FFFFFF">
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Nhan}" Margin="0,0,0,1" Text="Giá tiền"/>
                                            <TextBox Style="{StaticResource O}" Margin="0" Text="{Binding GiaTien}" Foreground="#1565C0"
                                                     VerticalAlignment="Center" ToolTip="Giá báo giá (ghi vào MText thông tin tấm)"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MoRong}" Value="True">
                                        <Setter TargetName="Mui" Property="Text" Value="▾"/>
                                        <Setter TargetName="ChiTiet" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CoLoi}" Value="True">
                                        <Setter TargetName="OTen" Property="Background" Value="#FDECEA"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource The}" Margin="10,8,10,10">
            <StackPanel>
                <TextBlock Text="{Binding TrangThai}" TextWrapping="Wrap"/>
                <StackPanel Visibility="{Binding CoFile, Converter={StaticResource HienKhi}}" Margin="0,6,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="6,0,0,0" Content="Mở" Command="{Binding MoFile10Cmd}"/>
                        <TextBlock Text="{Binding File10}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#555"/>
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="6,0,0,0" Content="Mở" Command="{Binding MoFile35Cmd}"/>
                        <TextBlock Text="{Binding File35}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#555"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
