<UserControl x:Class="CsvTool.Views.CsvTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HienKhi"/>

        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutPhu" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Foreground" Value="#323639"/>
            <Setter Property="Background" Value="#E4E7EC"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
        </Style>
        <!-- o gia tri trong the tam: TextBox khong vien, Enter = ghi -->
        <Style x:Key="O" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="KeyDown" Handler="OPhim"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SuaDuoc}" Value="False">
                    <Setter Property="IsReadOnly" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Background" Value="#DDEBF7"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,1,1"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- nut vien (Xuat CSV): nen trang, vien + chu mau tab (dat o code-behind) -->
        <Style x:Key="NutVien" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- danh sach tam -->
            <RowDefinition Height="Auto"/>   <!-- nut + che do tinh + trang thai -->
        </Grid.RowDefinitions>

        <!-- Header: cung kieu tab AI / Guro, nut cai dat nen trang banh rang to mau tab -->
        <Border Grid.Row="0" Background="{Binding AccentBrush}" Padding="12,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding CaiDatCmd}"
                        Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                        ToolTip="Cài đặt CSV: thứ tự tấm, layer, bước spline, dung sai khe hở">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#CFD8DC"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#CFD8DC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Rectangle Width="18" Height="18" Fill="{Binding AccentBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding SettingsLogo}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TieuDe}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#E8F5E9" FontSize="10.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource The}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="0" Content="{Binding NhanChiTiet}"
                            Command="{Binding ChiTietCmd}" ToolTip="Mở hoặc thu gọn mọi thẻ tấm"/>
                    <CheckBox DockPanel.Dock="Left" Content="Chỉ tấm lỗi" IsChecked="{Binding ChiLoi}" VerticalAlignment="Center"/>
                    <Border Margin="8,0" Background="#FFFFFF" BorderBrush="#B0BEC5" BorderThickness="1" CornerRadius="5" Height="26">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#78909C"
                                       Margin="7,0,5,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="×" Width="20" Foreground="#607D8B" Cursor="Hand" Focusable="False"
                                    Click="XoaTim" ToolTip="Xoá từ khoá (Esc)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TimKiem}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Grid>
                                <TextBlock Text="Tìm tên, vật liệu..." Foreground="#90A4AE" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TimKiem}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="OTim" Text="{Binding TimKiem, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                         BorderThickness="0" Padding="0" VerticalContentAlignment="Center" PreviewKeyDown="TimPhim"
                                         ToolTip="Tìm theo tên, vật liệu, độ dày, số lượng, X, Y, gia công. Nhiều từ cách nhau bằng dấu cách"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
                <!-- Danh sach tong hop loi: bam dong = zoom toi vi tri loi, bam tiep = vi tri ke -->
                <Expander DockPanel.Dock="Top" IsExpanded="True" Margin="10,0,10,8" Foreground="#C62828" FontWeight="SemiBold"
                          Header="{Binding NhanDsLoi}" Visibility="{Binding CoDsLoi, Converter={StaticResource HienKhi}}">
                    <ScrollViewer x:Name="CuonLoi" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding DsLoi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="DongLoiBd" Background="#FFF8E1" BorderBrush="#FFCA28" BorderThickness="3,0,0,0" CornerRadius="2"
                                            Padding="6,3" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonUp="LoiBam"
                                            ToolTip="Bấm để zoom tới lỗi, bấm tiếp để sang vị trí kế">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding NhanViTri}" Foreground="#1565C0" FontWeight="Normal"
                                                       FontSize="11" Margin="6,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Ten}" Foreground="#263238" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding NoiDung}" Foreground="#37474F" FontWeight="Normal" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LaLoi}" Value="True">
                                            <Setter TargetName="DongLoiBd" Property="Background" Value="#FDECEA"/>
                                            <Setter TargetName="DongLoiBd" Property="BorderBrush" Value="#C62828"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
                <ScrollViewer x:Name="Cuon" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                    <ItemsControl ItemsSource="{Binding DongHien}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 1 the tam: hang tren ten + gia tien, thong so full ngang (palette hep). Nen xam + khe 1px = vien o -->
                                <Border BorderBrush="#90A4AE" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6"
                                        Background="#CFD8DC" PreviewMouseLeftButtonDown="TheBam">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                        <DockPanel x:Name="OTen" Background="#E2F0D9" Margin="0,0,1,1">
                                            <TextBlock x:Name="Mui" DockPanel.Dock="Left" Text="▸" Width="18" Padding="5,0,0,0"
                                                       VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MuiBam"
                                                       ToolTip="Mở / thu gọn tấm này"/>
                                            <TextBox Style="{StaticResource O}" Text="{Binding N}" FontWeight="SemiBold" Background="Transparent"
                                                     TextWrapping="Wrap" HorizontalContentAlignment="Left" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Grid.Column="1" Background="#FFFFFF" Margin="0,0,0,1">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Nhan}" Margin="0,0,1,0" Padding="5,4,5,0" Text="Giá tiền"/>
                                            <Button DockPanel.Dock="Right" Content="↺" Width="18" Cursor="Hand" BorderThickness="0" Background="Transparent"
                                                    Foreground="#E65100" Click="GiaTuDongBam" ToolTip="Giá sửa tay. Bấm để quay về giá tự tính"
                                                    Visibility="{Binding LaGiaTay, Converter={StaticResource HienKhi}}"/>
                                            <TextBox Margin="0" Text="{Binding GiaTien}" VerticalAlignment="Center" ToolTip="Đơn giá 1 tấm (lưu ở data CSV)">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource O}">
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LaGiaTay}" Value="True">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </DockPanel>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                            <TextBlock x:Name="LoiChu" Text="{Binding Loi}" Foreground="#C62828" TextWrapping="Wrap" Padding="6,4"
                                                       Background="#FDECEA" Margin="0,0,1,1"
                                                       Visibility="{Binding CoLoi, Converter={StaticResource HienKhi}}"/>
                                            <StackPanel Visibility="{Binding SuaDuoc, Converter={StaticResource HienKhi}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.7*"/>
                                                        <ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Style="{StaticResource Nhan}" Text="Q"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="M"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="T"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="X × Y"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="4" Text="Gia công" ToolTip="Loại gia công"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Text="{Binding Q}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding M}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding T}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="3" Text="{Binding XxY, Mode=OneWay}" IsReadOnly="True"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="4" Text="{Binding LoaiGiaCong}"/>
                                                </Grid>
                                                <StackPanel x:Name="ChiTiet" Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.65*"/>
                                                            <ColumnDefinition Width="0.65*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.9*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Lỗ nhỏ"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Lỗ lớn"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Tapu" ToolTip="Lỗ Tappu"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="Sara" ToolTip="Lỗ Sara"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="4" Text="Pitchi lần × dài" ToolTip="Pitchi: số lần × chiều dài"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="5" Text="Dài vát" ToolTip="Chiều dài vát"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Text="{Binding LoNho, Mode=OneWay}" IsReadOnly="True"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding LoLon, Mode=OneWay}" IsReadOnly="True"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding Tappu}" ToolTip="Lỗ Tappu"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="3" Text="{Binding Sara}" ToolTip="Lỗ Sara"/>
                                                        <Grid Grid.Row="1" Grid.Column="4" Background="#FFFFFF" Margin="0,0,1,1">
                                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                            <TextBox Style="{StaticResource O}" Margin="0" Text="{Binding PitchiSoLan}" ToolTip="Pitchi - Số lần"/>
                                                            <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center"/>
                                                            <TextBox Style="{StaticResource O}" Grid.Column="2" Margin="0" Text="{Binding PitchiDai}" ToolTip="Pitchi - Chiều dài (mm)"/>
                                                        </Grid>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="5" Text="{Binding Vat}"/>
                                                    </Grid>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Đường bẻ: số đường × chiều dài" TextAlignment="Center"/>
                                                        <TextBlock Text="{Binding DuongBe}" Background="#FFFFFF" Padding="6,3" Margin="0,0,1,1"
                                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <!-- thong tin chi dung de tinh gia, luu o data\<don>-gia.json -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.8*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Loại pitchi"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Cuộn" ToolTip="Nửa hình 6.000, cả hình 12.000. Tự nhận theo r1 / r2"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Đặt ngoài" ToolTip="Đơn giá vật liệu đặt ngoài (khi bảng giá = 0)"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="Tròn 250" ToolTip="Giá dưới 250 thì tính 250"/>
                                                        <ComboBox Grid.Row="1" Margin="0,0,1,1" BorderThickness="0" Background="#FFFFFF" FontSize="11"
                                                                  ItemsSource="{Binding DsLoaiPitchi}" SelectedItem="{Binding LoaiPitchi}" PreviewMouseWheel="ComboKhongLan"/>
                                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,1,1" BorderThickness="0" Background="#FFFFFF" FontSize="11"
                                                                  ItemsSource="{Binding DsLoaiCuon}" SelectedItem="{Binding LoaiCuonGia}" PreviewMouseWheel="ComboKhongLan"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding DonGiaDatNgoai}"/>
                                                        <Border Grid.Row="1" Grid.Column="3" Background="#FFFFFF" Margin="0,0,1,1">
                                                            <CheckBox IsChecked="{Binding LamTron250}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MoRong}" Value="True">
                                        <Setter TargetName="Mui" Property="Text" Value="▾"/>
                                        <Setter TargetName="ChiTiet" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CoLoi}" Value="True">
                                        <Setter TargetName="OTen" Property="Background" Value="#FDECEA"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BoQua}" Value="True">
                                        <Setter TargetName="OTen" Property="Background" Value="#ECEFF1"/>
                                        <Setter TargetName="LoiChu" Property="Foreground" Value="#607D8B"/>
                                        <Setter TargetName="LoiChu" Property="Background" Value="#F5F7FA"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Thanh duoi: tong don · 3 nut luon 1 hang · trang thai -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0" Padding="10,8,10,10">
            <StackPanel>
                <TextBlock Text="{Binding NhanTongTien}" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NutQuet" Style="{StaticResource Nut}" Margin="0,0,6,0" Padding="4,8" Command="{Binding QuetCmd}"
                            Content="Quét..." ToolTip="Mở thiết lập quét và tính giá"/>
                    <Button x:Name="NutTinhGia" Grid.Column="1" Style="{StaticResource NutVien}" Margin="0,0,6,0" Command="{Binding TinhGiaCmd}"
                            Content="Tính giá" ToolTip="Tính lại giá mọi tấm, không quét; giá sửa tay được giữ"/>
                    <Button x:Name="NutXuat" Grid.Column="2" Style="{StaticResource NutVien}" Command="{Binding XuatCsvCmd}"
                            Content="Xuất CSV" ToolTip="Tạo file cuối &lt;đơn&gt;.csv (10 cột gửi nhà máy) từ danh sách tấm; còn tấm lỗi thì không ghi"/>
                </Grid>

                <TextBlock Text="{Binding TrangThai}" TextWrapping="Wrap" Foreground="#52606D"/>
                <DockPanel Margin="0,6,0,0" Visibility="{Binding CoFile10, Converter={StaticResource HienKhi}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="6,0,0,0" Padding="8,3" Content="Mở" Command="{Binding MoFile10Cmd}"/>
                    <TextBlock Text="{Binding File10}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#555"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0" Visibility="{Binding CoFile35, Converter={StaticResource HienKhi}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="6,0,0,0" Padding="8,3" Content="Mở" Command="{Binding MoFile35Cmd}"/>
                    <TextBlock Text="{Binding File35}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#555"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
