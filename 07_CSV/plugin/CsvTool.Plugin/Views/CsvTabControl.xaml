<UserControl x:Class="CsvTool.Views.CsvTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HienKhi"/>
        <SolidColorBrush x:Key="Mau" Color="#1E7F4F"/>

        <Style x:Key="Nut" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutPhu" TargetType="Button" BasedOn="{StaticResource Nut}">
            <Setter Property="Foreground" Value="#323639"/>
            <Setter Property="Background" Value="#E4E7EC"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="The" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
        </Style>
        <!-- o gia tri trong the tam: TextBox khong vien, Enter = ghi -->
        <Style x:Key="O" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="PreviewKeyDown" Handler="OPhim"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SuaDuoc}" Value="False">
                    <Setter Property="IsReadOnly" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Mau}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Mau}" Padding="2,6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mau}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4 tab chia deu chieu ngang palette -->
        <Style TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,0,0,2" Padding="2,5">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mau}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TenTab" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#323F4B"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DemTab" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#607D8B"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- o co vien cho dong duong be va gia VL -->
        <Style x:Key="OVien" TargetType="TextBox" BasedOn="{StaticResource O}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <!-- tag cong ty, cung bo mau voi web tinh tien -->
        <Style x:Key="TagCt" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,3,3,0"/>
        </Style>
        <Style x:Key="TieuMuc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Nhan" TargetType="TextBlock">
            <Setter Property="Background" Value="#DDEBF7"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,1,1"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- 4 tab -->
            <RowDefinition Height="Auto"/>   <!-- tong don + trang thai + 2 file -->
        </Grid.RowDefinitions>

        <!-- Header: cung kieu tab AI / Guro, nut cai dat nen trang banh rang to mau tab -->
        <Border Grid.Row="0" Background="{Binding AccentBrush}" Padding="12,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding CaiDatCmd}"
                        Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                        ToolTip="Cài đặt CSV: thứ tự tấm, layer, bước spline, dung sai khe hở">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#CFD8DC"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEFF1"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#CFD8DC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Rectangle Width="18" Height="18" Fill="{Binding AccentBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding SettingsLogo}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TieuDe}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MoTa}" Foreground="#E8F5E9" FontSize="10.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource The}" Padding="0">
            <TabControl SelectedIndex="{Binding TabDangChon}" BorderThickness="0" Padding="0" Background="Transparent">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Top" Rows="1" IsItemsHost="True"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Thong tin chung: thay dialog thiet lap quet -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TenTab}" Text="Home"/>
                            <TextBlock Style="{StaticResource DemTab}" Text="{Binding NhanTabChung}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer x:Name="CuonChung" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10">
                            <TextBlock Text="{Binding NhanBanVe}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NhanKhung}" FontSize="11" Foreground="#607D8B" Margin="0,1,0,10" TextTrimming="CharacterEllipsis"/>
                            <Border Height="1" Background="#E1E4E8" Margin="0,0,0,10"/>
                            <CheckBox Content="Tính giá sau khi quét" FontWeight="SemiBold" Margin="0,0,0,9"
                                      IsChecked="{Binding TinhGiaBat}" IsEnabled="{Binding CoGiaDon}"/>
                            <Grid IsEnabled="{Binding TinhGiaBat}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Công ty" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="OCongTy" Padding="5,3" IsEnabled="{Binding CoGiaDon}"
                                             Text="{Binding TimCongTy, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="CongTyVao" LostKeyboardFocus="CongTyRoi" PreviewKeyDown="CongTyPhim"
                                             ToolTip="Gõ hoặc dán tên phiên âm / tiếng Nhật. Đổi sau khi quét là tính lại giá tự động"/>
                                    <ListBox x:Name="DsCT" ItemsSource="{Binding DsCongTyLoc}" MaxHeight="190" BorderBrush="#B0BEC5" BorderThickness="1,0,1,1"
                                             Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                             PreviewMouseLeftButtonDown="CongTyBam" Visibility="{Binding HienDsCongTy, Converter={StaticResource HienKhi}}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Background="Transparent">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource TagCt}" Margin="3,0,0,0" Background="#F3E8FF" Visibility="{Binding LaDacBiet, Converter={StaticResource HienKhi}}">
                                                            <TextBlock Text="★ Đặc biệt" FontSize="10.5" Foreground="#7E22CE"/>
                                                        </Border>
                                                        <Border Style="{StaticResource TagCt}" Margin="3,0,0,0" Background="#DCFCE7" Visibility="{Binding UuDai, Converter={StaticResource HienKhi}}">
                                                            <TextBlock Text="Ưu đãi" FontSize="10.5" Foreground="#15803D"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Ten}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TiengNhat}" FontSize="11" Foreground="#607D8B" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding CoTiengNhat, Converter={StaticResource HienKhi}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- tag cua cong ty dang chon, nhu web tinh tien -->
                                    <StackPanel Margin="0,3,0,0" Visibility="{Binding CoCongTyChon, Converter={StaticResource HienKhi}}">
                                        <TextBlock Text="{Binding CongTyChon.TiengNhat}" FontSize="11" Foreground="#607D8B" TextWrapping="Wrap"
                                                   Visibility="{Binding CongTyChon.CoTiengNhat, Converter={StaticResource HienKhi}}"/>
                                        <WrapPanel>
                                            <Border Style="{StaticResource TagCt}" Background="#F3E8FF" Visibility="{Binding CongTyChon.LaDacBiet, Converter={StaticResource HienKhi}}">
                                                <TextBlock Text="★ Công ty đặc biệt" FontSize="11" Foreground="#7E22CE"/>
                                            </Border>
                                            <Border Style="{StaticResource TagCt}" Background="#F3F4F6" Visibility="{Binding CongTyChon.LaDacBiet, Converter={StaticResource HienKhi}}">
                                                <TextBlock Text="Tính theo khối lượng" FontSize="11" Foreground="#4B5563"/>
                                            </Border>
                                            <Border Style="{StaticResource TagCt}" Background="#EFF6FF" Visibility="{Binding CongTyChon.LaDacBiet, Converter={StaticResource HienKhi}}">
                                                <TextBlock Text="{Binding CongTyChon.NhanTamDon}" FontSize="11" Foreground="#2563EB"/>
                                            </Border>
                                            <Border Style="{StaticResource TagCt}" Background="#FFF7ED" Visibility="{Binding CongTyChon.LaDacBiet, Converter={StaticResource HienKhi}}">
                                                <TextBlock Text="{Binding CongTyChon.NhanTamBe}" FontSize="11" Foreground="#EA580C"/>
                                            </Border>
                                            <Border Style="{StaticResource TagCt}" Background="#DCFCE7" Visibility="{Binding CongTyChon.UuDai, Converter={StaticResource HienKhi}}">
                                                <TextBlock Text="Ưu đãi" FontSize="11" Foreground="#15803D"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Chế độ tính" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource Mau}" BorderThickness="1" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CheDoDon" Content="Thường" IsChecked="{Binding CheDo0}" BorderThickness="0">
                                            <RadioButton.Tag><CornerRadius>4,0,0,4</CornerRadius></RadioButton.Tag>
                                        </RadioButton>
                                        <RadioButton Grid.Column="1" Style="{StaticResource Seg}" GroupName="CheDoDon" Content="Gia công" IsChecked="{Binding CheDo1}" BorderThickness="1,0,0,0">
                                            <RadioButton.Tag><CornerRadius>0</CornerRadius></RadioButton.Tag>
                                        </RadioButton>
                                        <RadioButton Grid.Column="2" Style="{StaticResource Seg}" GroupName="CheDoDon" Content="VL khách" IsChecked="{Binding CheDo2}" BorderThickness="1,0,0,0">
                                            <RadioButton.Tag><CornerRadius>0,4,4,0</CornerRadius></RadioButton.Tag>
                                        </RadioButton>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MoTaCheDo}" FontSize="11" Foreground="#7B8794" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <Border Height="1" Background="#E1E4E8" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource TieuMuc}" Text="Tùy chọn tính giá" Margin="0,0,0,6"/>
                                    <CheckBox Content="Tự động làm tròn 250" IsChecked="{Binding LamTron250Don}"/>
                                    <TextBlock Text="Tấm dưới 250 ¥ được tính thành 250 ¥." FontSize="11" Foreground="#7B8794" Margin="20,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <!-- tao file A va PDF nhanh: chay sau khi quet neu khong con loi -->
                            <Border Height="1" Background="#E1E4E8" Margin="0,12,0,8"/>
                            <TextBlock Style="{StaticResource TieuMuc}" Text="Tạo file A và PDF nhanh:" Margin="0,0,0,6"/>
                            <CheckBox Content="Tạo file A" IsChecked="{Binding TaoFileA}"/>
                            <TextBlock Text="{Binding NhanFileA}" FontSize="11" Foreground="#7B8794" Margin="20,2,0,6" TextWrapping="Wrap"/>
                            <CheckBox Content="In PDF" IsChecked="{Binding InPdf}"/>
                            <TextBlock Text="{Binding NhanPdf}" FontSize="11" Foreground="#7B8794" Margin="20,2,0,4" TextWrapping="Wrap"/>
                            <Grid Margin="20,0,0,0" IsEnabled="{Binding InPdf}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Profile in" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DsProfileIn}" SelectedItem="{Binding ProfileIn}"
                                          DropDownOpened="ProfileInMo" PreviewMouseWheel="ComboKhongLan" ToolTip="Tạo / sửa profile ở tab PRINT"/>
                            </Grid>
                            <TextBlock Text="{Binding LoiThietLap}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding CoLoiThietLap, Converter={StaticResource HienKhi}}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Nut}" Background="{DynamicResource Mau}" Margin="0" Padding="4,8" Content="Quét theo vùng"
                                        Command="{Binding QuetVungCmd}" ToolTip="Kéo chọn khung trên bản vẽ"/>
                                <Button Grid.Column="2" Style="{StaticResource Nut}" Background="{DynamicResource Mau}" Margin="0" Padding="4,8" Content="Quét toàn bản vẽ"
                                        Command="{Binding QuetToanCmd}" ToolTip="Quét mọi khung tấm trên bản vẽ"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource NutPhu}" Margin="0" Padding="4,7" Content="Xuất file A"
                                        Command="{Binding XuatFileACmd}" ToolTip="Tạo file A từ lượt quét gần nhất (đã có file thì hỏi trước khi ghi đè)"/>
                                <Button Grid.Column="2" Style="{StaticResource NutPhu}" Margin="0" Padding="4,7" Content="Xuất PDF"
                                        Command="{Binding XuatPdfCmd}" ToolTip="In PDF các tấm của lượt quét gần nhất (đã có file thì hỏi trước khi ghi đè)"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Danh sach tam -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TenTab}" Text="List"/>
                            <TextBlock Style="{StaticResource DemTab}" Text="{Binding NhanTabTam}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="0" Content="{Binding NhanChiTiet}"
                            Command="{Binding ChiTietCmd}" ToolTip="Mở hoặc thu gọn mọi thẻ tấm"/>
                    <CheckBox DockPanel.Dock="Left" Content="Chỉ tấm lỗi" IsChecked="{Binding ChiLoi}" VerticalAlignment="Center"/>
                    <Border Margin="8,0" Background="#FFFFFF" BorderBrush="#B0BEC5" BorderThickness="1" CornerRadius="5" Height="26">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#78909C"
                                       Margin="7,0,5,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="×" Width="20" Foreground="#607D8B" Cursor="Hand" Focusable="False"
                                    Click="XoaTim" ToolTip="Xoá từ khoá (Esc)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TimKiem}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Grid>
                                <TextBlock Text="Tìm tên, vật liệu..." Foreground="#90A4AE" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TimKiem}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="OTim" Text="{Binding TimKiem, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                         BorderThickness="0" Padding="0" VerticalContentAlignment="Center" PreviewKeyDown="TimPhim"
                                         ToolTip="Tìm theo tên, vật liệu, độ dày, số lượng, X, Y, gia công. Nhiều từ cách nhau bằng dấu cách"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
                <ScrollViewer x:Name="Cuon" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                    <ItemsControl ItemsSource="{Binding DongHien}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 1 the tam: hang tren ten + gia tien, thong so full ngang (palette hep). Nen xam + khe 1px = vien o -->
                                <Border BorderBrush="#90A4AE" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6"
                                        Background="#CFD8DC" PreviewMouseLeftButtonDown="TheBam">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                        <DockPanel x:Name="OTen" Background="#E2F0D9" Margin="0,0,1,1">
                                            <TextBlock x:Name="Mui" DockPanel.Dock="Left" Text="▸" Width="18" Padding="5,0,0,0"
                                                       VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MuiBam"
                                                       ToolTip="Mở / thu gọn tấm này"/>
                                            <TextBox Style="{StaticResource O}" Text="{Binding N}" FontWeight="SemiBold" Background="Transparent"
                                                     TextWrapping="Wrap" HorizontalContentAlignment="Left" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- o gia noi bat: vang = gia tu tinh, cam = gia sua tay -->
                                        <DockPanel Grid.Column="1" Margin="0,0,0,1">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Background" Value="#FFF3C4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LaGiaTay}" Value="True">
                                                            <Setter Property="Background" Value="#FFE0B2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <Border DockPanel.Dock="Left" Width="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LaGiaTay}" Value="True">
                                                                <Setter Property="Background" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="↺" Width="18" Cursor="Hand" BorderThickness="0" Background="Transparent"
                                                    Foreground="#BF360C" Click="GiaTuDongBam" ToolTip="Giá sửa tay. Bấm để quay về giá tự tính"
                                                    Visibility="{Binding LaGiaTay, Converter={StaticResource HienKhi}}"/>
                                            <TextBox x:Name="OGia" DockPanel.Dock="Right" Margin="0,0,3,0" MinWidth="34" Text="{Binding GiaTien}" VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Right" FontSize="14" FontWeight="SemiBold" Background="Transparent"
                                                     ToolTip="Đơn giá 1 tấm (lưu ở data CSV)">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource O}">
                                                        <Setter Property="Foreground" Value="#1B5E20"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LaGiaTay}" Value="True">
                                                                <Setter Property="Foreground" Value="#BF360C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock DockPanel.Dock="Right" Text="@" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, ElementName=OGia}" ToolTip="Đơn giá 1 tấm"/>
                                            <TextBlock Text="{Binding NhanGia}" FontSize="11" Padding="5,0,3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Foreground, ElementName=OGia}"/>
                                        </DockPanel>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                            <TextBlock x:Name="LoiChu" Text="{Binding Loi}" Foreground="#C62828" TextWrapping="Wrap" Padding="6,4"
                                                       Background="#FDECEA" Margin="0,0,1,1"
                                                       Visibility="{Binding CoLoi, Converter={StaticResource HienKhi}}"/>
                                            <StackPanel Visibility="{Binding SuaDuoc, Converter={StaticResource HienKhi}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.6*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.7*"/>
                                                        <ColumnDefinition Width="0.95*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="0.9*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Style="{StaticResource Nhan}" Text="Q"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="M"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="T"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="X"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="4" Text="Y"/>
                                                    <TextBlock Style="{StaticResource Nhan}" Grid.Column="5" Text="Gia công" ToolTip="Loại gia công"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Text="{Binding Q}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding M}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding T}"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="3" Text="{Binding X, Mode=OneWay}" IsReadOnly="True" ToolTip="Đọc từ kích thước trên bản vẽ"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="4" Text="{Binding Y, Mode=OneWay}" IsReadOnly="True" ToolTip="Đọc từ kích thước trên bản vẽ"/>
                                                    <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="5" Text="{Binding LoaiGiaCong}"/>
                                                </Grid>
                                                <StackPanel x:Name="ChiTiet" Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Lỗ nhỏ"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Lỗ lớn"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Tapu" ToolTip="Lỗ Tappu"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="Sara" ToolTip="Lỗ Sara"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="4" Text="Dài vát" ToolTip="Chiều dài vát"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Text="{Binding LoNho, Mode=OneWay}" IsReadOnly="True"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding LoLon, Mode=OneWay}" IsReadOnly="True"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding Tappu}" ToolTip="Lỗ Tappu"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="3" Text="{Binding Sara}" ToolTip="Lỗ Sara"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="4" Text="{Binding Vat}"/>
                                                    </Grid>
                                                    <!-- Be / uon: moi loai 1 dong -->
                                                    <StackPanel Background="#FFFFFF" Margin="0,0,1,1">
                                                        <DockPanel Margin="6,4,4,3">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource NutPhu}" Margin="0" Padding="7,2" FontSize="11"
                                                                    Content="+ Thêm đường bẻ" Click="ThemBeBam"/>
                                                            <TextBlock Style="{StaticResource TieuMuc}" Text="Bẻ / uốn"/>
                                                        </DockPanel>
                                                        <ItemsControl x:Name="DsBe" ItemsSource="{Binding Be}" Margin="6,0,4,3">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                        <TextBlock Text="Số đường" FontSize="11" Foreground="#607D8B"/>
                                                                        <TextBlock Grid.Column="2" Text="Dài (mm)" FontSize="11" Foreground="#607D8B"/>
                                                                        <TextBox Grid.Row="1" Style="{StaticResource OVien}" Text="{Binding So}"/>
                                                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource OVien}" Text="{Binding Dai}"/>
                                                                        <Button Grid.Row="1" Grid.Column="3" Content="×" Foreground="#C62828" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                                Click="XoaBeBam" ToolTip="Xoá loại đường bẻ này"
                                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- Pitchi: loai, so duong nhan, chieu dai canh nhau -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Loại pitchi"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Số đường nhấn"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Dài pitchi" ToolTip="Chiều dài pitchi (mm)"/>
                                                        <ComboBox Grid.Row="1" Margin="0,0,1,1" BorderThickness="0" Background="#FFFFFF" FontSize="11"
                                                                  ItemsSource="{Binding DsLoaiPitchi}" SelectedItem="{Binding LoaiPitchi}" PreviewMouseWheel="ComboKhongLan"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding PitchiSoLan}"/>
                                                        <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding PitchiDai}"/>
                                                    </Grid>
                                                    <!-- thong tin chi dung de tinh gia, luu o data\<don>-gia.json -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.7*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Nhan}" Text="Chế độ tính" ToolTip="Chọn riêng cho tấm này, quét lại vẫn giữ"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Giá VL" ToolTip="Tiền vật liệu 1 tấm. Gõ số tự tính thì giá = số này + cắt + gia công. Xoá trống để tính lại bình thường"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Cuộn" ToolTip="Nửa hình 6.000, cả hình 12.000. Tự nhận theo r1 / r2"/>
                                                        <TextBlock Style="{StaticResource Nhan}" Grid.Column="3" Text="Tròn 250" ToolTip="Giá dưới 250 thì tính 250"/>
                                                        <ComboBox Grid.Row="1" Margin="0,0,1,1" BorderThickness="0" Background="#FFFFFF" FontSize="11"
                                                                  ItemsSource="{Binding DsCheDo}" SelectedIndex="{Binding CheDoChon}" PreviewMouseWheel="ComboKhongLan"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TienVl}" IsEnabled="{Binding ChoSuaTienVl}"
                                                                 ToolTip="Tiền vật liệu 1 tấm. Gõ số tự tính thì giá = số này + cắt + gia công. Xoá trống để tính lại bình thường">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource O}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding LaVlTay}" Value="True">
                                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,0,1,1" BorderThickness="0" Background="#FFFFFF" FontSize="11"
                                                                  ItemsSource="{Binding DsLoaiCuon}" SelectedItem="{Binding LoaiCuonGia}" PreviewMouseWheel="ComboKhongLan"/>
                                                        <Border Grid.Row="1" Grid.Column="3" Background="#FFFFFF" Margin="0,0,1,1">
                                                            <CheckBox IsChecked="{Binding LamTron250}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding GhiChuGia}" FontSize="10.5" Foreground="#B45309" Background="#FFF8E1" Padding="6,2"
                                                       Margin="0,0,1,1" TextWrapping="Wrap" Visibility="{Binding CoGhiChuGia, Converter={StaticResource HienKhi}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MoRong}" Value="True">
                                        <Setter TargetName="Mui" Property="Text" Value="▾"/>
                                        <Setter TargetName="ChiTiet" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CoLoi}" Value="True">
                                        <Setter TargetName="OTen" Property="Background" Value="#FDECEA"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BoQua}" Value="True">
                                        <Setter TargetName="OTen" Property="Background" Value="#ECEFF1"/>
                                        <Setter TargetName="LoiChu" Property="Foreground" Value="#607D8B"/>
                                        <Setter TargetName="LoiChu" Property="Background" Value="#F5F7FA"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Loi va canh bao: bam dong = zoom toi vi tri loi, bam tiep = vi tri ke -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TenTab}" Text="Error"/>
                            <TextBlock Style="{StaticResource DemTab}" Text="{Binding NhanTabLoi}" Tag="{Binding TabLoiDo}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer x:Name="CuonLoi" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Không có lỗi hay cảnh báo." Foreground="#2E7D32" Margin="2,4"
                                       Visibility="{Binding KhongCoLoi, Converter={StaticResource HienKhi}}"/>
                            <ItemsControl ItemsSource="{Binding DsLoi}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="DongLoiBd" Background="#FFF8E1" BorderBrush="#FFCA28" BorderThickness="3,0,0,0" CornerRadius="2"
                                                Padding="6,3" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonUp="LoiBam"
                                                ToolTip="Bấm để zoom tới lỗi, bấm tiếp để sang vị trí kế">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding NhanViTri}" Foreground="#1565C0" FontSize="11" TextAlignment="Right"/>
                                                    <Button Style="{StaticResource NutPhu}" Margin="0,2,0,0" Padding="6,1" FontSize="11" Content="Nhập giá" Click="NhapGiaBam"
                                                            Visibility="{Binding LaThieuGia, Converter={StaticResource HienKhi}}"/>
                                                    <Button Style="{StaticResource NutPhu}" Margin="0,2,0,0" Padding="6,1" FontSize="11" Content="Sửa theo bảng" Click="SuaFnameBam"
                                                            ToolTip="Ghi lại dòng này trên F-name theo dữ liệu Fname"
                                                            Visibility="{Binding CoSuaFname, Converter={StaticResource HienKhi}}"/>
                                                    <Button Style="{StaticResource NutPhu}" Margin="0,2,0,0" Padding="6,1" FontSize="11" Content="Bổ sung" Click="BoSungFnameBam"
                                                            ToolTip="Mở cửa sổ Bổ sung vật liệu của tab Fname để gửi admin duyệt"
                                                            Visibility="{Binding CoBoSung, Converter={StaticResource HienKhi}}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Ten}" Foreground="#263238" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding NoiDung}" Foreground="#37474F" TextWrapping="Wrap"/>
                                                    <!-- nhap nhanh pitchi: du so lan va chieu dai thi dong loi tu mat -->
                                                    <Border Margin="0,4,0,1" Background="#E1E4E8" Padding="1,1,0,0" Cursor="Arrow" MouseLeftButtonUp="ChanBam"
                                                            ToolTip="Nhập xong bấm Enter hoặc Tab để lưu"
                                                            Visibility="{Binding LaThieuPitchi, Converter={StaticResource HienKhi}}">
                                                        <Grid DataContext="{Binding Dong}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                            <TextBlock Style="{StaticResource Nhan}" Text="Loại pitchi"/>
                                                            <TextBlock Style="{StaticResource Nhan}" Grid.Column="1" Text="Số đường nhấn"/>
                                                            <TextBlock Style="{StaticResource Nhan}" Grid.Column="2" Text="Dài pitchi"/>
                                                            <ComboBox Grid.Row="1" Margin="0,0,1,1" BorderThickness="0" Background="#FFFFFF" FontSize="11"
                                                                      ItemsSource="{Binding DsLoaiPitchi}" SelectedItem="{Binding LoaiPitchi}" PreviewMouseWheel="ComboKhongLan"/>
                                                            <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="1" Text="{Binding PitchiSoLan}"/>
                                                            <TextBox Style="{StaticResource O}" Grid.Row="1" Grid.Column="2" Text="{Binding PitchiDai}"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding LaLoi}" Value="True">
                                                <Setter TargetName="DongLoiBd" Property="Background" Value="#FDECEA"/>
                                                <Setter TargetName="DongLoiBd" Property="BorderBrush" Value="#C62828"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Gia VL: gia tam luu o data\<don>-giavl.csv -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TenTab}" Text="Giá VL"/>
                            <TextBlock Style="{StaticResource DemTab}" Text="{Binding NhanTabGia}" Tag="{Binding TabGiaDo}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="#ECEFF1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Vật liệu · dày" FontSize="11" Foreground="#52606D" Padding="10,4"/>
                            <TextBlock Grid.Column="1" Text="Tấm" FontSize="11" Foreground="#52606D" Padding="0,4" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Giá VL (¥/kg)" FontSize="11" Foreground="#52606D" Padding="0,4,10,4" TextAlignment="Right"/>
                        </Grid>
                        <ScrollViewer x:Name="CuonGia" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DsGiaVl}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="DongVl" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <Grid Margin="10,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Ten}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="NguonVl" Text="{Binding Nguon}" FontSize="11" Foreground="#607D8B" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SoTam}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2" Style="{StaticResource OVien}" Margin="6,0,0,0" Text="{Binding GiaVL}" TextAlignment="Right"
                                                             ToolTip="Giá tạm của đơn. Xoá trống để bỏ giá tạm"
                                                             Visibility="{Binding HienNhap, Converter={StaticResource HienKhi}}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding NhanGiaBang}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1B5E20"
                                                               Visibility="{Binding HienGiaBang, Converter={StaticResource HienKhi}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ChuaCoDb}" Value="True">
                                                <Setter TargetName="DongVl" Property="Background" Value="#FFF8E1"/>
                                                <Setter TargetName="NguonVl" Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Thieu}" Value="True">
                                                <Setter TargetName="DongVl" Property="Background" Value="#FDECEA"/>
                                                <Setter TargetName="NguonVl" Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Thanh duoi: tong don · trang thai · 2 file (CSV tu cap nhat) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0" Padding="10,8,10,10">
            <StackPanel>
                <TextBlock Text="{Binding NhanTongTien}" ToolTip="{Binding NhanTongTien}" FontWeight="SemiBold" Foreground="#1B5E20" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding NhanKg}" Visibility="{Binding CoNhanKg, Converter={StaticResource HienKhi}}" TextWrapping="Wrap" Foreground="#1B5E20" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding TrangThai}" TextWrapping="Wrap" Foreground="#52606D"/>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource NutPhu}" Padding="6,5" Content="File CSV" Command="{Binding MoFile10Cmd}"
                            IsEnabled="{Binding CoFile10}" ToolTip="{Binding File10}" ToolTipService.ShowOnDisabled="False"/>
                    <Button Grid.Column="1" Style="{StaticResource NutPhu}" Padding="6,5" Content="File data" Command="{Binding MoFile35Cmd}"
                            IsEnabled="{Binding CoFile35}" ToolTip="{Binding File35}" ToolTipService.ShowOnDisabled="False"/>
                    <Button Grid.Column="2" Style="{StaticResource NutPhu}" Padding="6,5" Content="File A" Command="{Binding MoFileACmd}" ToolTip="Mở file &lt;đơn&gt;-A.dxf"/>
                    <Button Grid.Column="3" Style="{StaticResource NutPhu}" Margin="0" Padding="6,5" Content="PDF" Command="{Binding MoPdfCmd}" ToolTip="Mở file &lt;đơn&gt;.pdf"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
